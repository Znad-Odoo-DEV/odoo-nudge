<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The webhook only keeps what a phone says; this answers it, one message at a time -->
    <record id="cron_answer" model="ir.cron">
        <field name="name">Nudge Messaging: answer the messages that wait</field>
        <field name="model_id" ref="model_nudge_messaging"/>
        <field name="state">code</field>
        <field name="code">model._cron_answer()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
