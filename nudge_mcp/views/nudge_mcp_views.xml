<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_mcp_help_view_form" model="ir.ui.view">
        <field name="name">nudge.mcp.help.view.form</field>
        <field name="model">nudge.mcp.help</field>
        <field name="arch" type="xml">
            <form string="External Assistants (MCP)" create="0" delete="0">
                <field name="is_enabled" invisible="1"/>
                <field name="can_create_key" invisible="1"/>
                <field name="is_https" invisible="1"/>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="is_enabled">
                        Nudge is closed to external assistants. An administrator turns it on in
                        Settings, Nudge, External Assistants (MCP).
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="is_https">
                        The address of this Odoo does not start with https: assistants such as Claude refuse to
                        sign in to it. Set the address of the server (web.base.url) to its https address.
                    </div>
                    <h2>Connect an assistant to Nudge</h2>
                    <p class="text-muted">
                        Claude Desktop, ChatGPT and other assistants that speak MCP can then look up
                        records and the documentation, and prepare changes, as you: with your rights,
                        your record rules and your companies. A change is made only after you have said yes
                        to it in Odoo.
                    </p>
                    <group>
                        <field name="server_url" widget="CopyClipboardChar"/>
                    </group>
                    <h3>1. Give the assistant this address</h3>
                    <p>
                        Claude (claude.ai and Claude Desktop): Settings, Connectors, Add custom connector, and paste
                        the address above. ChatGPT and other assistants: add an MCP server by its address. The
                        assistant then opens Odoo: sign in, read what it asks, and press Allow. You choose there
                        whether it may only read or also prepare changes. Only people of the group External
                        Assistant can allow one.
                    </p>
                    <div class="text-muted" invisible="can_create_key">
                        Ask an administrator to add you to the group External Assistant.
                    </div>
                    <p class="mt-3">Claude Code, in a terminal:</p>
                    <field name="claude_code_command" widget="CopyClipboardText" nolabel="1"/>
                    <p class="mt-3">Claude Desktop through a configuration file (claude_desktop_config.json; needs
                        Node.js, for npx and mcp-remote, which signs in the same way):</p>
                    <field name="claude_config" widget="CopyClipboardText" nolabel="1"/>
                    <p class="mt-3">Other assistants, in a configuration file:</p>
                    <field name="generic_config" widget="CopyClipboardText" nolabel="1"/>
                    <h3 class="mt-4">2. See and revoke what you connected</h3>
                    <p>
                        Your preferences, Connected Assistants: each assistant you allowed, what it may do, and when
                        it was last used. Revoke one and it has to ask you again.
                    </p>
                    <h3 class="mt-4">With a key (legacy)</h3>
                    <p class="text-muted">
                        For an assistant that cannot sign in. A key opens reading and preparing changes until it
                        expires; it is shown once, and you see and delete your keys in your preferences, Account
                        Security. A change prepared with a key always waits for your yes in Odoo.
                    </p>
                    <button name="action_create_key" type="object" string="Make a Key (legacy)" class="btn-secondary"
                            invisible="not can_create_key or not is_enabled"/>
                    <p class="mt-3">Replace YOUR_NUDGE_KEY with your key:</p>
                    <field name="legacy_config" widget="CopyClipboardText" nolabel="1"/>
                    <p class="mt-3">To look from a terminal:</p>
                    <field name="curl_example" widget="CopyClipboardText" nolabel="1"/>
                    <p class="mt-3">Paste your key and press Test: Nudge calls initialize with it, as an assistant does.</p>
                    <group>
                        <field name="test_key" password="True"/>
                        <field name="test_result" nolabel="0"/>
                    </group>
                    <button name="action_test" type="object" string="Test" class="btn-secondary"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_mcp_key_view_form" model="ir.ui.view">
        <field name="name">nudge.mcp.key.view.form</field>
        <field name="model">nudge.mcp.key</field>
        <field name="arch" type="xml">
            <form string="New Key for an Assistant (legacy)">
                <group invisible="key">
                    <field name="name"/>
                    <field name="duration"/>
                </group>
                <div invisible="not key">
                    <div class="alert alert-warning" role="alert">
                        Copy the key now: it is not shown again. Anyone who holds it can use Nudge as you.
                    </div>
                    <div class="text-muted mb-2">
                        Keys are kept for assistants that cannot sign in. Claude, ChatGPT and most others sign in
                        with the address of the server instead: no key to copy, and you can revoke them one by one.
                    </div>
                    <field name="key" widget="CopyClipboardChar"/>
                </div>
                <footer>
                    <button name="action_create" type="object" string="Make the Key" class="btn-primary"
                            invisible="key"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="nudge_mcp_help_action" model="ir.actions.server">
        <field name="name">External Assistants (MCP)</field>
        <field name="model_id" ref="model_nudge_mcp_help"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <menuitem id="nudge_mcp_menu_help" name="External Assistants" parent="nudge.nudge_menu_configuration"
              action="nudge_mcp_help_action" sequence="60"
              groups="-nudge.group_nudge_manager,-base.group_system,nudge.group_nudge_advanced_menus"/>

    <record id="nudge_step_view_form_mcp" model="ir.ui.view">
        <field name="name">nudge.step.view.form.mcp</field>
        <field name="model">nudge.step</field>
        <field name="inherit_id" ref="nudge.nudge_step_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mcp_approve" type="object" string="Yes, let the assistant do it"
                        class="btn-primary" invisible="state != 'pending' or not origin"/>
                <button name="action_mcp_refuse" type="object" string="No"
                        invisible="state != 'pending' or not origin"/>
            </xpath>
        </field>
    </record>

    <record id="nudge_step_action_mcp_approvals" model="ir.actions.act_window">
        <field name="name">Changes Assistants Ask For</field>
        <field name="res_model">nudge.step</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending'), ('origin', '!=', False), ('user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No assistant is waiting for you</p>
            <p>When an external assistant wants to change something, it waits here until you say yes.</p>
        </field>
    </record>

    <menuitem id="nudge_mcp_menu_approvals" name="Assistant Approvals" parent="nudge.nudge_menu_approvals"
              action="nudge_step_action_mcp_approvals" sequence="10"
              groups="nudge.group_nudge_manager,-nudge_mcp.group_nudge_mcp"/>

    <record id="nudge_run_view_list_mcp" model="ir.ui.view">
        <field name="name">nudge.run.view.list.mcp</field>
        <field name="model">nudge.run</field>
        <field name="inherit_id" ref="nudge.nudge_run_view_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="origin" optional="show"/>
                <field name="mcp_client_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="nudge_run_view_search_mcp" model="ir.ui.view">
        <field name="name">nudge.run.view.search.mcp</field>
        <field name="model">nudge.run</field>
        <field name="inherit_id" ref="nudge.nudge_run_view_search"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="origin"/>
                <filter name="from_mcp" string="From External Assistants" domain="[('origin', 'like', 'MCP:%')]"/>
            </field>
        </field>
    </record>

    <record id="nudge_step_view_list_mcp" model="ir.ui.view">
        <field name="name">nudge.step.view.list.mcp</field>
        <field name="model">nudge.step</field>
        <field name="inherit_id" ref="nudge.nudge_step_view_list"/>
        <field name="arch" type="xml">
            <field name="kind" position="after">
                <field name="origin" optional="show"/>
                <field name="mcp_self_confirmed" optional="show"/>
            </field>
        </field>
    </record>

    <record id="nudge_step_view_search_mcp" model="ir.ui.view">
        <field name="name">nudge.step.view.search.mcp</field>
        <field name="model">nudge.step</field>
        <field name="inherit_id" ref="nudge.nudge_step_view_search"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="origin"/>
                <filter name="from_mcp" string="From External Assistants" domain="[('origin', 'like', 'MCP:%')]"/>
                <filter name="mcp_self_confirmed" string="Confirmed by the Assistant"
                        domain="[('mcp_self_confirmed', '=', True)]"/>
            </field>
        </field>
    </record>
</odoo>
