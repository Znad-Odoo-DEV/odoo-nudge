<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- S4: the answers kept for a while by a connector are forgotten once their time is up -->
    <record id="cron_connector_cache_purge" model="ir.cron">
        <field name="name">Nudge: forget the kept answers of connectors</field>
        <field name="model_id" ref="model_nudge_connector_cache"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
