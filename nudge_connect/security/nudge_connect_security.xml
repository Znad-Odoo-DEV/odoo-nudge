        <field name="name">Nudge connector calls: own companies</field>
        <field name="model_id" ref="model_nudge_connector_call"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
