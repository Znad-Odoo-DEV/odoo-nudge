<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_read_pages" model="ir.cron">
        <field name="name">Nudge: read the published pages for the website assistant</field>
        <field name="model_id" ref="nudge.model_nudge_source"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_website_pages()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="cron_archive_visitor_lines" model="ir.cron">
        <field name="name">Nudge: archive old visitor messages of the website assistant</field>
        <field name="model_id" ref="model_nudge_web_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_archive_old()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
