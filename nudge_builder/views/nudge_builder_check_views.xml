<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rights: website designers run the check and read its reports; the oldest reports are removed by Nudge -->
    <record id="access_nudge_builder_check_designer" model="ir.model.access">
        <field name="name">nudge.builder.check designer</field>
        <field name="model_id" ref="model_nudge_builder_check"/>
        <field name="group_id" ref="website.group_website_designer"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_nudge_builder_check_finding_designer" model="ir.model.access">
        <field name="name">nudge.builder.check.finding designer</field>
        <field name="model_id" ref="model_nudge_builder_check_finding"/>
        <field name="group_id" ref="website.group_website_designer"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_nudge_builder_check_fix_designer" model="ir.model.access">
        <field name="name">nudge.builder.check.fix designer</field>
        <field name="model_id" ref="model_nudge_builder_check_fix"/>
        <field name="group_id" ref="website.group_website_designer"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_nudge_builder_check_run_designer" model="ir.model.access">
        <field name="name">nudge.builder.check.run designer</field>
        <field name="model_id" ref="model_nudge_builder_check_run"/>
        <field name="group_id" ref="website.group_website_designer"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="nudge_builder_check_view_list" model="ir.ui.view">
        <field name="name">nudge.builder.check.list</field>
        <field name="model">nudge.builder.check</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="date"/>
                <field name="website_id"/>
                <field name="user_id"/>
                <field name="summary"/>
            </list>
        </field>
    </record>

    <record id="nudge_builder_check_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.check.form</field>
        <field name="model">nudge.builder.check</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <h1><field name="website_id" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="summary"/>
                        </group>
                        <group>
                            <field name="external"/>
                            <field name="previous_id"/>
                        </group>
                    </group>
                    <field name="skipped_text" invisible="not skipped_text"/>
                    <field name="finding_ids">
                        <list create="false" delete="false" decoration-danger="severity == 'critical'"
                              decoration-warning="severity == 'warning'">
                            <field name="severity"/>
                            <field name="group_label"/>
                            <field name="text"/>
                            <field name="count"/>
                            <field name="is_new" optional="show"/>
                            <field name="delta" optional="show"/>
                            <field name="fix" column_invisible="1"/>
                            <field name="fix_title" column_invisible="1"/>
                            <button name="action_show" type="object" string="Show me" icon="fa-eye"/>
                            <button name="action_fix" type="object" string="Fix it" icon="fa-magic"
                                    invisible="not fix"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_builder_check_fix_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.check.fix.form</field>
        <field name="model">nudge.builder.check.fix</field>
        <field name="arch" type="xml">
            <form>
                <h2><field name="title" readonly="1"/></h2>
                <p>Nudge will make exactly these changes, as you. It only fills what is empty or adds an
                   unpublished draft; nothing is deleted or published.</p>
                <field name="lines" readonly="1" nolabel="1"/>
                <field name="done" invisible="1"/>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"
                            invisible="done"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="nudge_builder_check_run_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.check.run.form</field>
        <field name="model">nudge.builder.check.run</field>
        <field name="arch" type="xml">
            <form>
                <p>Checks the website for search engines, links, translations, speed, accessibility, legal
                   pages and the shop. Nothing is changed by the check.</p>
                <group>
                    <field name="website_id" options="{'no_create': True}"/>
                    <field name="external"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Check the site" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="nudge_builder_check_run_action" model="ir.actions.act_window">
        <field name="name">Site Check</field>
        <field name="res_model">nudge.builder.check.run</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="nudge_builder_check_action" model="ir.actions.act_window">
        <field name="name">Site Check Reports</field>
        <field name="res_model">nudge.builder.check</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No site check yet</p>
            <p>Each check of a built site is kept here with what it found.</p>
        </field>
    </record>

    <menuitem id="menu_nudge_builder_check_run" name="Site Check" parent="nudge_builder.menu_nudge_builder"
              action="nudge_builder_check_run_action" sequence="40"
              groups="website.group_website_designer"/>
    <menuitem id="menu_nudge_builder_check_reports" name="Site Check Reports"
              parent="nudge_builder.menu_nudge_builder" action="nudge_builder_check_action" sequence="41"
              groups="website.group_website_designer"/>
</odoo>
