<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_builder_project_view_list" model="ir.ui.view">
        <field name="name">nudge.builder.project.list</field>
        <field name="model">nudge.builder.project</field>
        <field name="arch" type="xml">
            <tree string="Project">
                <field name="sequence" widget="handle"/>
                <field name="cover_image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="category"/>
                <field name="location"/>
                <field name="year"/>
                <field name="status"/>
                <field name="featured" optional="show"/>
                <field name="published" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="nudge_builder_project_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.project.form</field>
        <field name="model">nudge.builder.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="summary"/>
                            <field name="category"/>
                            <field name="location"/>
                            <field name="year"/>
                            <field name="status"/>
                            <field name="client" invisible="not show_client"/>
                        </group>
                        <group>
                            <field name="featured"/>
                            <field name="published"/>
                            <field name="before_picture_id" options="{'no_create': True}"/>
                            <field name="after_picture_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Listing" invisible="not listing_mode">
                            <field name="listing_status"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price"/>
                            <field name="area"/>
                            <field name="bedrooms"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe it with facts: what was done, for whom, how big."/>
                    <separator string="Pictures"/>
                    <field name="picture_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="image" widget="image" options="{'size': [64, 64]}"/>
                            <field name="name"/>
                            <field name="alt"/>
                        </tree>
                    </field>
                    <field name="listing_mode" invisible="1"/>
                    <field name="show_client" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_builder_product_view_list" model="ir.ui.view">
        <field name="name">nudge.builder.product.list</field>
        <field name="model">nudge.builder.product</field>
        <field name="arch" type="xml">
            <tree string="Product">
                <field name="sequence" widget="handle"/>
                <field name="cover_image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="category"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="featured" optional="show"/>
                <field name="published" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="nudge_builder_product_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.product.form</field>
        <field name="model">nudge.builder.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="summary"/>
                            <field name="category"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="featured"/>
                            <field name="published"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <separator string="Pictures"/>
                    <field name="picture_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="image" widget="image" options="{'size': [64, 64]}"/>
                            <field name="name"/>
                            <field name="alt"/>
                        </tree>
                    </field>
                    <field name="listing_mode" invisible="1"/>
                    <field name="show_client" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_builder_service_view_list" model="ir.ui.view">
        <field name="name">nudge.builder.service.list</field>
        <field name="model">nudge.builder.service</field>
        <field name="arch" type="xml">
            <tree string="Service">
                <field name="sequence" widget="handle"/>
                <field name="cover_image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="summary"/>
                <field name="icon"/>
                <field name="quote"/>
                <field name="featured" optional="show"/>
                <field name="published" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="nudge_builder_service_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.service.form</field>
        <field name="model">nudge.builder.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="summary"/>
                            <field name="icon"/>
                            <field name="quote"/>
                        </group>
                        <group>
                            <field name="featured"/>
                            <field name="published"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <separator string="Pictures"/>
                    <field name="picture_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="image" widget="image" options="{'size': [64, 64]}"/>
                            <field name="name"/>
                            <field name="alt"/>
                        </tree>
                    </field>
                    <field name="listing_mode" invisible="1"/>
                    <field name="show_client" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_builder_member_view_list" model="ir.ui.view">
        <field name="name">nudge.builder.member.list</field>
        <field name="model">nudge.builder.member</field>
        <field name="arch" type="xml">
            <tree string="Team member">
                <field name="sequence" widget="handle"/>
                <field name="cover_image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="role"/>
                <field name="specialty"/>
                <field name="featured" optional="show"/>
                <field name="published" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="nudge_builder_member_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.member.form</field>
        <field name="model">nudge.builder.member</field>
        <field name="arch" type="xml">
            <form string="Team member">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="role"/>
                            <field name="specialty"/>
                            <field name="linkedin" widget="url"/>
                            <field name="summary"/>
                        </group>
                        <group>
                            <field name="featured"/>
                            <field name="published"/>
                        </group>
                    </group>
                    <group>
                        <field name="bio"/>
                        <field name="hours"/>
                    </group>
                    <field name="description"/>
                    <separator string="Pictures"/>
                    <field name="picture_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="image" widget="image" options="{'size': [64, 64]}"/>
                            <field name="name"/>
                            <field name="alt"/>
                        </tree>
                    </field>
                    <field name="listing_mode" invisible="1"/>
                    <field name="show_client" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_builder_testimonial_view_list" model="ir.ui.view">
        <field name="name">nudge.builder.testimonial.list</field>
        <field name="model">nudge.builder.testimonial</field>
        <field name="arch" type="xml">
            <tree string="Testimonial">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [40, 40]}"/>
                <field name="author"/>
                <field name="author_role"/>
                <field name="company_name"/>
                <field name="rating"/>
                <field name="featured" optional="show"/>
                <field name="published" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="nudge_builder_testimonial_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.testimonial.form</field>
        <field name="model">nudge.builder.testimonial</field>
        <field name="arch" type="xml">
            <form string="Testimonial">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <group>
                        <group>
                            <field name="author"/>
                            <field name="author_role"/>
                            <field name="company_name"/>
                            <field name="rating"/>
                        </group>
                        <group>
                            <field name="featured"/>
                            <field name="published"/>
                        </group>
                    </group>
                    <field name="quote" placeholder="What the customer said, in their own words."/>
                    <field name="listing_mode" invisible="1"/>
                    <field name="show_client" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_builder_faq_view_list" model="ir.ui.view">
        <field name="name">nudge.builder.faq.list</field>
        <field name="model">nudge.builder.faq</field>
        <field name="arch" type="xml">
            <tree string="Question">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="featured" optional="show"/>
                <field name="published" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="nudge_builder_faq_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.faq.form</field>
        <field name="model">nudge.builder.faq</field>
        <field name="arch" type="xml">
            <form string="Question">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="featured"/>
                            <field name="published"/>
                        </group>
                    </group>
                    <field name="description" placeholder="The answer"/>
                    <field name="listing_mode" invisible="1"/>
                    <field name="show_client" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_builder_location_view_list" model="ir.ui.view">
        <field name="name">nudge.builder.location.list</field>
        <field name="model">nudge.builder.location</field>
        <field name="arch" type="xml">
            <tree string="Location">
                <field name="sequence" widget="handle"/>
                <field name="cover_image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="phone"/>
                <field name="is_main"/>
                <field name="featured" optional="show"/>
                <field name="published" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="nudge_builder_location_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.location.form</field>
        <field name="model">nudge.builder.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <group>
                        <group string="Place">
                            <field name="name"/>
                            <field name="is_main"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_id" options="{'no_create': True}"/>
                            <field name="zip"/>
                            <field name="country_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Contact">
                            <field name="phone" widget="phone"/>
                            <field name="whatsapp" placeholder="+971501234567"/>
                            <field name="email" widget="email"/>
                            <field name="featured"/>
                            <field name="published"/>
                        </group>
                        <group string="Map">
                            <field name="maps_url" placeholder="https://maps.app.goo.gl/..."/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="maps_embed_src" widget="url"/>
                        </group>
                        <group string="Hours">
                            <field name="hours" nolabel="1" placeholder="Sun-Thu 08:00-17:00"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <separator string="Pictures"/>
                    <field name="picture_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="image" widget="image" options="{'size': [64, 64]}"/>
                            <field name="name"/>
                            <field name="alt"/>
                        </tree>
                    </field>
                    <field name="listing_mode" invisible="1"/>
                    <field name="show_client" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_builder_social_view_list" model="ir.ui.view">
        <field name="name">nudge.builder.social.list</field>
        <field name="model">nudge.builder.social</field>
        <field name="arch" type="xml">
            <tree string="Social links" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="network"/>
                <field name="url" widget="url"/>
            </tree>
        </field>
    </record>
</odoo>
