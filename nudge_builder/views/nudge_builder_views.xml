<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_builder_site_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.site.form</field>
        <field name="model">nudge.builder.site</field>
        <field name="arch" type="xml">
            <form string="Website Builder">
                <header>
                    <button name="action_preview" type="object" string="Show me three directions" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_preview" type="object" string="Redraw the directions"
                            invisible="state != 'previewed'"/>
                    <button name="action_build" type="object" string="Build this website" class="btn-primary"
                            invisible="state != 'previewed'"/>
                    <button name="action_continue" type="object" string="Continue the build" class="btn-primary"
                            invisible="not stopped or state == 'published'"/>
                    <button name="action_import_content" type="object" string="Import content"/>
                    <button name="action_show_records" type="object" string="Show the records on the site"
                            invisible="state not in ('built', 'published')" groups="website.group_website_designer"/>
                    <button name="action_open_editor" type="object" string="Open the home page in the editor"
                            invisible="state not in ('built', 'published')"/>
                    <button name="action_publish" type="object" string="Publish all pages"
                            invisible="state not in ('built', 'published')"
                            confirm="Every page of this site becomes visible to everybody, and its home page becomes the home page of the website. You can undo it afterwards. Continue?"/>
                    <button name="action_undo_publish" type="object" string="Undo publish"
                            invisible="not last_publish_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,previewed,built,published"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="not private">
                        No AI writes text or pictures here (no provider, or Private Mode is on): the pages are built from the sample copy of the template and the bundled placeholder pictures.
                    </div>
                    <div class="alert alert-success d-flex align-items-center gap-3" role="status"
                         invisible="state != 'published' or not last_publish_id">
                        <span class="flex-grow-1">All pages of this site are published and its home page is the home page of the website.</span>
                        <button name="action_undo_publish" type="object" string="Undo publish" class="btn btn-secondary"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                    </div>
                    <group invisible="state not in ('draft', 'previewed')">
                        <group string="1. Your business">
                            <field name="website_id" readonly="state != 'draft'"/>
                            <field name="kind" placeholder="Contracting, clinic, restaurant, shop..." readonly="state != 'draft'"/>
                            <field name="template_key" readonly="state != 'draft'"/>
                        </group>
                        <group string="2. Languages">
                            <field name="lang_ids" widget="many2many_tags" options="{'no_create': True}" readonly="state != 'draft'"/>
                        </group>
                        <group string="3. Colours and fonts">
                            <field name="color_primary" widget="color" readonly="state != 'draft'"/>
                            <field name="color_secondary" widget="color" readonly="state != 'draft'"/>
                            <field name="color_accent" widget="color" readonly="state != 'draft'"/>
                            <field name="color_light" widget="color" readonly="state != 'draft'"/>
                            <field name="color_dark" widget="color" readonly="state != 'draft'"/>
                            <field name="font_heading" readonly="state != 'draft'"/>
                            <field name="font_body" readonly="state != 'draft'"/>
                            <field name="colors_from_logo" invisible="not colors_from_logo"/>
                        </group>
                        <group string="4. Pages wanted">
                            <field name="kind_ids" widget="many2many_checkboxes" readonly="state != 'draft'"/>
                            <field name="allow_projects" readonly="state != 'draft'"/>
                            <field name="allow_team" readonly="state != 'draft'"/>
                        </group>
                        <group string="5. Online shop" invisible="not shop_available">
                            <field name="shop_available" invisible="1"/>
                            <field name="shop" readonly="state != 'draft'"/>
                        </group>
                        <group string="6. Tone">
                            <field name="tone" widget="radio" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group invisible="state != 'previewed'" string="Pick a direction">
                        <field name="direction" widget="radio" options="{'horizontal': true}"/>
                        <field name="preview_html" nolabel="1" colspan="2"/>
                    </group>
                    <group invisible="state not in ('built', 'published')" string="Pages built">
                        <field name="page_ids" nolabel="1" colspan="2">
                            <list create="0" delete="0">
                                <field name="name_shown"/>
                                <field name="url"/>
                                <field name="snippet_keys"/>
                                <field name="seo_title" optional="show"/>
                                <field name="seo_description" optional="show"/>
                                <field name="is_published" widget="boolean"/>
                                <button name="action_open_editor" type="object" string="Open in editor" icon="fa-pencil"/>
                            </list>
                        </field>
                    </group>
                    <group invisible="state not in ('built', 'published')" string="Changes after the build">
                        <field name="revision_ids" nolabel="1" colspan="2">
                            <list create="0" delete="0" decoration-muted="state == 'undone'">
                                <field name="create_date"/>
                                <field name="kind"/>
                                <field name="name"/>
                                <field name="user_id"/>
                                <field name="state"/>
                                <button name="action_undo" type="object" string="Undo" icon="fa-undo"
                                        invisible="state != 'done'"
                                        confirm="Put the page back as it was before this change?"/>
                            </list>
                        </field>
                    </group>
                    <notebook>
                        <page string="Projects" name="content_project" invisible="'project' not in kinds_used">
                            <div class="text-muted mb-2"><field name="project_count" class="oe_inline"/> records. Pictures, names and descriptions come from here: nothing else is shown on the website.</div>
                            <field name="project_ids" nolabel="1"/>
                        </page>
                        <page string="Products" name="content_product" invisible="'product' not in kinds_used">
                            <div class="text-muted mb-2" invisible="shop_mode"><field name="product_count" class="oe_inline"/> records. Prices are optional: leave one empty to show none.</div>
                            <field name="product_ids" nolabel="1" invisible="shop_mode"/>
                            <div invisible="not shop_mode">
                                <p class="text-muted">The products of the online shop are Odoo products. Add the ones you already have, or make new ones there (they stay unpublished until you publish them).</p>
                                <button name="action_shop_products" type="object" string="Open the shop products" class="btn btn-secondary me-2"/>
                                <button name="action_add_sellable_products" type="object" string="Add the products on sale" class="btn btn-secondary"/>
                            </div>
                        </page>
                        <page string="Services" name="content_service" invisible="'service' not in kinds_used">
                            <div class="text-muted mb-2"><field name="service_count" class="oe_inline"/> records. Pictures, names and descriptions come from here: nothing else is shown on the website.</div>
                            <field name="service_ids" nolabel="1"/>
                        </page>
                        <page string="Team" name="content_member" invisible="'member' not in kinds_used">
                            <div class="text-muted mb-2"><field name="member_count" class="oe_inline"/> records. Pictures, names and descriptions come from here: nothing else is shown on the website.</div>
                            <field name="member_ids" nolabel="1"/>
                        </page>
                        <page string="Testimonials" name="content_testimonial" invisible="'testimonial' not in kinds_used">
                            <div class="text-muted mb-2"><field name="testimonial_count" class="oe_inline"/> records. Pictures, names and descriptions come from here: nothing else is shown on the website.</div>
                            <field name="testimonial_ids" nolabel="1"/>
                        </page>
                        <page string="Questions" name="content_faq" invisible="'faq' not in kinds_used">
                            <div class="text-muted mb-2"><field name="faq_count" class="oe_inline"/> records. Pictures, names and descriptions come from here: nothing else is shown on the website.</div>
                            <field name="faq_ids" nolabel="1"/>
                        </page>
                        <page string="Locations" name="content_location" invisible="'location' not in kinds_used">
                            <div class="d-flex align-items-center mb-2">
                                <span class="text-muted flex-grow-1"><field name="location_count" class="oe_inline"/> records. One map is placed for each.</span>
                                <button name="action_fill_from_company" type="object" string="Fill from the company" class="btn btn-secondary"/>
                            </div>
                            <field name="location_ids" nolabel="1"/>
                        </page>
                        <page string="Contact &amp; links" name="content_contact">
                            <group>
                                <group string="Contact">
                                    <field name="whatsapp" placeholder="+971501234567"/>
                                    <field name="whatsapp_text" placeholder="Hello, I would like to ask about..."/>
                                    <field name="whatsapp_float"/>
                                    <field name="phone" widget="phone"/>
                                    <field name="email" widget="email"/>
                                    <field name="booking_url" widget="url"/>
                                </group>
                                <group string="On the website">
                                    <field name="quote_form"/>
                                    <field name="show_client"/>
                                </group>
                                <group string="Working hours">
                                    <field name="hours" nolabel="1" placeholder="Sun-Thu 08:00-17:00"/>
                                </group>
                            </group>
                            <separator string="Social links"/>
                            <field name="social_ids" nolabel="1"/>
                        </page>
                    </notebook>
                    <field name="kinds_used" invisible="1"/>
                    <field name="listing_mode" invisible="1"/>
                    <field name="shop_mode" invisible="1"/>
                    <field name="last_publish_id" invisible="1"/>
                    <field name="log" readonly="1" invisible="not log"/>
                    <field name="private" invisible="1"/>
                    <field name="stopped" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_builder_site_view_list" model="ir.ui.view">
        <field name="name">nudge.builder.site.list</field>
        <field name="model">nudge.builder.site</field>
        <field name="arch" type="xml">
            <list string="Websites">
                <field name="name"/>
                <field name="website_id"/>
                <field name="kind"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="nudge_builder_action_new" model="ir.actions.act_window">
        <field name="name">New site</field>
        <field name="res_model">nudge.builder.site</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="nudge_builder_action_sites" model="ir.actions.act_window">
        <field name="name">Sites built</field>
        <field name="res_model">nudge.builder.site</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No site built yet</p>
            <p>Ask Nudge in Developer mode to build a website: it appears here.</p>
        </field>
    </record>

    <record id="nudge_builder_shop_confirm_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.shop.confirm.form</field>
        <field name="model">nudge.builder.shop.confirm</field>
        <field name="arch" type="xml">
            <form>
                <h2>Arrange the shop too?</h2>
                <p>Nudge will make exactly these changes, as you. It fills what is empty and adds unpublished
                   drafts; nothing is deleted or published.</p>
                <field name="lines" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_yes" type="object" string="Yes, arrange the shop" class="btn-primary"/>
                    <button name="action_no" type="object" string="No, build the pages only"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- One entry, under Activity (managers only, through the parent): New site and Site Check are buttons of its list -->
    <menuitem id="menu_nudge_builder_sites" name="Website Builder" parent="nudge.nudge_menu_agent" sequence="80"
              action="nudge_builder_action_sites" groups="website.group_website_designer"/>
</odoo>
