<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- A website designer of one company does not read, or change, the sites of another -->
        <record id="nudge_builder_site_rule_company" model="ir.rule">
            <field name="name">Nudge Builder Site: companies of the user</field>
            <field name="model_id" ref="model_nudge_builder_site"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="nudge_builder_page_rule_company" model="ir.rule">
            <field name="name">Nudge Builder Page: companies of the user</field>
            <field name="model_id" ref="model_nudge_builder_page"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="nudge_builder_check_rule_company" model="ir.rule">
            <field name="name">Nudge Site Check: companies of the user</field>
            <field name="model_id" ref="model_nudge_builder_check"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="nudge_builder_check_finding_rule_company" model="ir.rule">
            <field name="name">Nudge Site Check Finding: companies of the user</field>
            <field name="model_id" ref="model_nudge_builder_check_finding"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
