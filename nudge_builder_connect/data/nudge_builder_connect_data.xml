<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Two connectors of Nudge Connectors, one per provider. They come in draft with no client: an administrator
         creates the OAuth client at the provider, enters its ID and secret, and activates them. -->
    <data noupdate="1">
        <record id="connector_google" model="nudge.connector">
            <field name="name">Google (Website Builder)</field>
            <field name="key">builder_google</field>
            <field name="url">https://www.googleapis.com/</field>
            <field name="auth_type">oauth_user</field>
            <field name="oauth_authorize_url">https://accounts.google.com/o/oauth2/v2/auth?access_type=offline&amp;prompt=consent</field>
            <field name="oauth_token_url">https://oauth2.googleapis.com/token</field>
            <field name="oauth_revocation_url">https://oauth2.googleapis.com/revoke</field>
            <field name="oauth_scope">https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/business.manage</field>
            <field name="runs_locally" eval="False"/>
        </record>
        <record id="connector_instagram" model="nudge.connector">
            <field name="name">Instagram (Website Builder)</field>
            <field name="key">builder_instagram</field>
            <field name="url">https://graph.instagram.com/</field>
            <field name="auth_type">oauth_user</field>
            <field name="oauth_authorize_url">https://www.instagram.com/oauth/authorize</field>
            <field name="oauth_token_url">https://api.instagram.com/oauth/access_token</field>
            <field name="oauth_scope">instagram_business_basic</field>
            <field name="runs_locally" eval="False"/>
        </record>
    </data>
</odoo>
