<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_builder_connect_pull_view_form" model="ir.ui.view">
        <field name="name">nudge.builder.connect.pull.form</field>
        <field name="model">nudge.builder.connect.pull</field>
        <field name="arch" type="xml">
            <form string="Pull from a connected account">
                <field name="state" invisible="1"/>
                <field name="site_id" invisible="1"/>
                <field name="source" invisible="1"/>
                <field name="signed_in" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="state != 'setup' or signed_in">
                    You are not connected. Connect your own account: the provider asks you to agree on its own page,
                    then come back here and press Check the connection.
                </div>
                <div class="alert alert-success" role="alert" invisible="state != 'setup' or not signed_in">
                    You are connected with your own account. Only you can use this connection.
                </div>
                <group invisible="state != 'setup'">
                    <group invisible="source != 'drive'">
                        <field name="drive_link" placeholder="https://drive.google.com/drive/folders/..."/>
                    </group>
                    <group invisible="source not in ('drive', 'instagram')">
                        <field name="owner_kind" widget="radio"/>
                        <field name="project_id" invisible="owner_kind != 'project'"/>
                        <field name="product_id" invisible="owner_kind != 'product'"/>
                        <field name="service_id" invisible="owner_kind != 'service'"/>
                        <field name="member_id" invisible="owner_kind != 'member'"/>
                        <field name="location_id" invisible="owner_kind != 'location'"/>
                    </group>
                    <group invisible="source != 'business'">
                        <field name="take_places"/>
                        <field name="take_reviews"/>
                    </group>
                </group>
                <div class="text-muted" invisible="state != 'setup'">
                    Nothing is written before you have seen what was found and ticked it.
                </div>
                <group invisible="state != 'preview'">
                    <field name="notes" nolabel="1" colspan="2" invisible="not notes"/>
                </group>
                <field name="line_ids" invisible="state != 'preview'" nolabel="1">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="selected"/>
                        <field name="kind" readonly="1"/>
                        <field name="name"/>
                        <field name="info"/>
                        <field name="existing"/>
                        <field name="with_caption" column_invisible="parent.source != 'instagram'"
                               readonly="not caption"/>
                        <field name="caption" column_invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button string="Connect" name="action_connect" type="object" class="btn-primary"
                            invisible="state != 'setup' or signed_in"/>
                    <button string="Check the connection" name="action_refresh" type="object"
                            invisible="state != 'setup' or signed_in"/>
                    <button string="Preview" name="action_preview" type="object" class="btn-primary"
                            invisible="state != 'setup' or not signed_in"/>
                    <button string="Disconnect" name="action_disconnect" type="object"
                            invisible="state != 'setup' or not signed_in"/>
                    <button string="Take the ticked" name="action_take" type="object" class="btn-primary"
                            invisible="state != 'preview'"/>
                    <button string="Back" name="action_back" type="object" invisible="state != 'preview'"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="nudge_builder_site_view_form_connect" model="ir.ui.view">
        <field name="name">nudge.builder.site.form.connect</field>
        <field name="model">nudge.builder.site</field>
        <field name="inherit_id" ref="nudge_builder.nudge_builder_site_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_import_content']" position="after">
                <button name="action_pull_drive" type="object" string="Pull from Google Drive"/>
                <button name="action_pull_business" type="object" string="Pull from Google Business Profile"/>
                <button name="action_pull_instagram" type="object" string="Pull from Instagram"/>
            </xpath>
        </field>
    </record>
</odoo>
