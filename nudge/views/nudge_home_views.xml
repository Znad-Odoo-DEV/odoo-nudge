<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_home_action" model="ir.actions.client">
        <field name="name">My Nudge Home</field>
        <field name="tag">nudge_home</field>
    </record>

    <!-- The first screen of the Nudge app, and its first menu -->
    <record id="nudge_menu_root" model="ir.ui.menu">
        <field name="action" ref="nudge_home_action"/>
    </record>

    <menuitem id="nudge_menu_home" name="Home" sequence="1" parent="nudge_menu_root"
              action="nudge_home_action" groups="base.group_user"/>
</odoo>
