<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_agent_preview_view_form" model="ir.ui.view">
        <field name="name">nudge.agent.preview.view.form</field>
        <field name="model">nudge.agent.preview</field>
        <field name="arch" type="xml">
            <form string="Access Preview">
                <group>
                    <field name="agent_id"/>
                    <field name="user_id"/>
                </group>
                <field name="preview" readonly="1"/>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="nudge_agent_preview_action" model="ir.actions.act_window">
        <field name="name">Access Preview</field>
        <field name="res_model">nudge.agent.preview</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
