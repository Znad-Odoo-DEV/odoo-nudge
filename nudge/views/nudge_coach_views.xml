<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_coach_view_list" model="ir.ui.view">
        <field name="name">nudge.coach.view.list</field>
        <field name="model">nudge.coach</field>
        <field name="arch" type="xml">
            <tree string="Training" decoration-muted="state == 'trained'">
                <field name="user_id"/>
                <field name="state" widget="badge" decoration-success="state == 'trained'"
                       decoration-info="state == 'training'"/>
                <field name="progress" widget="progressbar"/>
                <field name="opened_count" string="Screens opened"/>
                <field name="screen_count" string="Of"/>
                <field name="tours_taken"/>
                <field name="last_activity"/>
                <button name="action_mark_trained" type="object" string="Mark trained" icon="fa-check"
                        class="btn-link" invisible="state == 'trained'"/>
            </tree>
        </field>
    </record>

    <record id="nudge_coach_view_form" model="ir.ui.view">
        <field name="name">nudge.coach.view.form</field>
        <field name="model">nudge.coach</field>
        <field name="arch" type="xml">
            <form string="Training">
                <header>
                    <button name="action_mark_trained" type="object" string="Mark trained" class="btn-primary"
                            invisible="state == 'trained'"/>
                    <button name="action_back_to_training" type="object" string="Back to training"
                            invisible="state == 'training'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" readonly="id"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="opened_count"/>
                            <field name="screen_count"/>
                        </group>
                        <group>
                            <field name="first_login"/>
                            <field name="last_activity"/>
                            <field name="trained_on" invisible="state != 'trained'"/>
                            <field name="is_manual" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="required_tour_ids" widget="many2many_tags"/>
                        <field name="done_tour_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_coach_view_search" model="ir.ui.view">
        <field name="name">nudge.coach.view.search</field>
        <field name="model">nudge.coach</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <filter name="training" string="In training" domain="[('state', '=', 'training')]"/>
                <filter name="trained" string="Trained" domain="[('state', '=', 'trained')]"/>
            </search>
        </field>
    </record>

    <record id="nudge_coach_assign_view_form" model="ir.ui.view">
        <field name="name">nudge.coach.assign.view.form</field>
        <field name="model">nudge.coach.assign</field>
        <field name="arch" type="xml">
            <form string="Assign tours">
                <group>
                    <field name="coach_ids" widget="many2many_tags"/>
                    <field name="tour_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="nudge_coach_assign_action" model="ir.actions.act_window">
        <field name="name">Assign tours</field>
        <field name="res_model">nudge.coach.assign</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_nudge_coach"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="nudge_coach_action" model="ir.actions.act_window">
        <field name="name">Training</field>
        <field name="res_model">nudge.coach</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_training': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody is in training</p>
            <p>A new user is followed for their first 14 days. Create a line to put somebody in training yourself.</p>
        </field>
    </record>

    <record id="nudge_coach_screen_view_list" model="ir.ui.view">
        <field name="name">nudge.coach.screen.view.list</field>
        <field name="model">nudge.coach.screen</field>
        <field name="arch" type="xml">
            <tree string="Key screens" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="module_name"/>
                <field name="action_xmlid"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="nudge_coach_screen_action" model="ir.actions.act_window">
        <field name="name">Key screens</field>
        <field name="res_model">nudge.coach.screen</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="nudge_menu_coach" name="Training" sequence="150"
              parent="nudge_menu_knowledge" action="nudge_coach_action"
              groups="-nudge.group_nudge_manager,-base.group_system,nudge.group_nudge_advanced_menus"/>
    <menuitem id="nudge_menu_coach_screens" name="Key Screens" sequence="20"
              parent="nudge_menu_advanced" action="nudge_coach_screen_action"/>
</odoo>
