<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_doc_passage_view_list" model="ir.ui.view">
        <field name="name">nudge.doc.passage.view.list</field>
        <field name="model">nudge.doc.passage</field>
        <field name="arch" type="xml">
            <list string="Passages" create="0" delete="0" edit="0">
                <field name="sequence"/>
                <field name="heading"/>
                <field name="body"/>
            </list>
        </field>
    </record>

    <record id="nudge_doc_passage_view_form" model="ir.ui.view">
        <field name="name">nudge.doc.passage.view.form</field>
        <field name="model">nudge.doc.passage</field>
        <field name="arch" type="xml">
            <form string="Passage" create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title"/></h1>
                        <h2><field name="heading" placeholder="Introduction"/></h2>
                    </div>
                    <field name="body" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_doc_page_view_list" model="ir.ui.view">
        <field name="name">nudge.doc.page.view.list</field>
        <field name="model">nudge.doc.page</field>
        <field name="arch" type="xml">
            <list string="Odoo Documentation" create="0" delete="0" edit="0">
                <field name="title"/>
                <field name="category"/>
                <field name="app"/>
                <field name="passage_count" string="Passages"/>
                <field name="modules" optional="hide"/>
                <field name="path" optional="hide"/>
                <button name="action_open" type="object" string="Read Online" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="nudge_doc_page_view_form" model="ir.ui.view">
        <field name="name">nudge.doc.page.view.form</field>
        <field name="model">nudge.doc.page</field>
        <field name="arch" type="xml">
            <form string="Page of the Documentation" create="0" delete="0" edit="0">
                <header>
                    <button name="action_open" type="object" string="Read Online" class="btn-primary"
                            icon="fa-external-link"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="app"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="path"/>
                            <field name="modules"/>
                        </group>
                    </group>
                    <field name="description" nolabel="1" placeholder="No description"/>
                    <notebook>
                        <page string="Passages" name="passages">
                            <field name="passage_ids" nolabel="1" context="{'list_view_ref': 'nudge.nudge_doc_passage_view_list'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_doc_page_view_search" model="ir.ui.view">
        <field name="name">nudge.doc.page.view.search</field>
        <field name="model">nudge.doc.page</field>
        <field name="arch" type="xml">
            <search string="Odoo Documentation">
                <field name="title"/>
                <field name="app"/>
                <field name="modules"/>
                <field name="passage_ids" string="Text" filter_domain="[('passage_ids.body', 'ilike', self)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_app" string="App" context="{'group_by': 'app'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="nudge_doc_page_action" model="ir.actions.act_window">
        <field name="name">Odoo Documentation</field>
        <field name="res_model">nudge.doc.page</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The documentation is not loaded</p>
            <p>Nudge loads the official documentation of Odoo when it is installed or updated.
               A manager can load it again from Settings ‣ Nudge.</p>
        </field>
    </record>
</odoo>
