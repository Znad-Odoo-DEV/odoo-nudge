<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_report_list" model="ir.ui.view">
        <field name="name">nudge.report.list</field>
        <field name="model">nudge.report</field>
        <field name="arch" type="xml">
            <list string="My Reports" editable="bottom" create="0" delete="0">
                <field name="name"/>
                <field name="shape"/>
                <field name="description" optional="show"/>
                <field name="home"/>
                <field name="user_id" groups="nudge.group_nudge_manager" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_open_report" type="object" string="Open" icon="fa-bar-chart"/>
            </list>
        </field>
    </record>

    <record id="nudge_report_form" model="ir.ui.view">
        <field name="name">nudge.report.form</field>
        <field name="model">nudge.report</field>
        <field name="arch" type="xml">
            <form string="Report" create="0" delete="0">
                <header>
                    <button name="action_open_report" type="object" string="Open" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="shape"/>
                        <field name="home"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_report_search" model="ir.ui.view">
        <field name="name">nudge.report.search</field>
        <field name="model">nudge.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="home" string="On My Home Page" domain="[('home', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="nudge_report_action" model="ir.actions.act_window">
        <field name="name">My Reports</field>
        <field name="res_model">nudge.report</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No saved report yet</p>
            <p>Ask Nudge for a chart or a pivot and say "save it": it is kept here, only for you.</p>
        </field>
    </record>

    <menuitem id="nudge_menu_my_reports" name="My Reports" sequence="12" parent="nudge_menu_root"
              action="nudge_report_action" groups="nudge.group_nudge_user"/>
</odoo>
