<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_provider_view_list" model="ir.ui.view">
        <field name="name">nudge.provider.view.list</field>
        <field name="model">nudge.provider</field>
        <field name="arch" type="xml">
            <tree string="AI Providers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="model_name"/>
                <field name="is_configured"/>
            </tree>
        </field>
    </record>

    <record id="nudge_provider_view_form" model="ir.ui.view">
        <field name="name">nudge.provider.view.form</field>
        <field name="model">nudge.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            class="btn-primary" groups="base.group_system"/>
                    <button name="action_fetch_models" type="object" string="Fetch Models"
                            groups="base.group_system"/>
                    <button name="action_ollama_prepare" type="object" string="Prepare for Nudge"
                            invisible="not is_ollama or not model_name" groups="base.group_system"
                            help="A copy of the model with the context Nudge needs, made on the Ollama server and chosen. Nothing is downloaded."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Google Gemini"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not context_warning">
                        <field name="context_warning" readonly="1" class="mb-0"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not notes">
                        <field name="notes" readonly="1" class="mb-0"/>
                    </div>
                    <group>
                        <group string="Connection" name="connection">
                            <field name="kind"/>
                            <field name="base_url" placeholder="https://api.example.com/v1"
                                   required="kind == 'openai_compatible'"/>
                            <field name="requires_api_key" invisible="kind == 'anthropic'"/>
                            <field name="api_key" password="True" invisible="not requires_api_key"/>
                            <field name="workspace_id" placeholder="wrkspc_..." invisible="kind != 'anthropic'"/>
                            <field name="timeout"/>
                            <field name="runs_locally" groups="base.group_system"/>
                            <div class="text-muted" colspan="2" groups="base.group_system"
                                 invisible="runs_locally or not looks_local">
                                The address looks like this machine or a private network. If the
                                model runs on your own server, tick Runs on Our Own Server.
                            </div>
                            <field name="looks_local" invisible="1"/>
                            <field name="address_warning" invisible="1"/>
                            <div class="alert alert-warning" colspan="2" role="alert"
                                 invisible="not address_warning">
                                <field name="address_warning" readonly="1" nolabel="1" class="mb-0"/>
                            </div>
                            <field name="is_ollama" invisible="not is_ollama"/>
                            <field name="ollama_version" invisible="not is_ollama"/>
                        </group>
                        <group string="Model" name="model">
                            <field name="model_name" placeholder="Pick one with Fetch Models"/>
                            <field name="max_output_tokens"/>
                            <field name="tool_set" required="1"/>
                            <field name="context_length" invisible="not is_ollama"/>
                            <field name="context_needed" invisible="not is_ollama"/>
                            <field name="picture_model" invisible="not is_ollama"
                                   placeholder="qwen2.5vl:3b"/>
                            <field name="effort"/>
                            <field name="refusal_fallback" invisible="kind != 'anthropic'"/>
                            <field name="is_configured"/>
                        </group>
                        <group string="Voice" name="voice" invisible="kind != 'openai_compatible'">
                            <field name="stt_mode"/>
                            <field name="stt_model" invisible="stt_mode == 'none'"
                                   required="stt_mode == 'endpoint'"
                                   placeholder="e.g. whisper-large-v3"/>
                            <field name="stt_url" invisible="stt_mode != 'endpoint'"
                                   placeholder="http://localhost:8000/v1"/>
                            <field name="can_transcribe"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Available Models" name="models">
                            <field name="model_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="size" optional="show"/>
                                    <field name="uses_tools" optional="show"/>
                                    <field name="sees_pictures" optional="show"/>
                                    <field name="context_max" optional="show"/>
                                    <field name="is_selected"/>
                                    <button name="action_select" type="object" string="Use"
                                            invisible="is_selected" groups="base.group_system"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Prices" name="prices">
                            <group>
                                <group string="Per Million Tokens">
                                    <field name="price_input"/>
                                    <field name="price_output"/>
                                    <field name="price_cache_read"/>
                                    <field name="price_cache_write"/>
                                </group>
                            </group>
                        </page>
                        <!-- S6 -->
                        <page string="Economy Model" name="economy">
                            <div class="text-muted mb-2">
                                A cheaper model of this provider answers the light work: questions in Talk, which change nothing, summaries, explanations and short texts. The model above answers what acts or builds, what is marked heavy, and once more what the economy model failed at. Each answer in the usage list says which one answered.
                            </div>
                            <group>
                                <group string="Model" name="economy_model">
                                    <field name="economy_model_name" placeholder="claude-haiku-5-5"/>
                                </group>
                                <group string="Per Million Tokens" name="economy_prices"
                                       invisible="not economy_model_name">
                                    <field name="economy_price_input"/>
                                    <field name="economy_price_output"/>
                                    <field name="economy_price_cache_read"/>
                                    <field name="economy_price_cache_write"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_provider_view_search" model="ir.ui.view">
        <field name="name">nudge.provider.view.search</field>
        <field name="model">nudge.provider</field>
        <field name="arch" type="xml">
            <search string="AI Providers">
                <field name="name"/>
                <field name="model_name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="nudge_provider_action" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">nudge.provider</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an AI provider</p>
            <p>Nudge answers through the first provider that has a model and a key.</p>
        </field>
    </record>
</odoo>
