<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_agent_view_list" model="ir.ui.view">
        <field name="name">nudge.agent.view.list</field>
        <field name="model">nudge.agent</field>
        <field name="arch" type="xml">
            <tree string="Agents" decoration-muted="state == 'archived'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="role"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'" decoration-info="state == 'tested'"
                       decoration-muted="state in ('draft', 'archived')"/>
                <field name="channels_label" string="Channels"/>
                <field name="score" optional="show"/>
                <field name="no_ai_share" optional="show"/>
                <field name="cost_month" optional="show"/>
                <field name="company_ids" widget="many2many_tags" optional="show" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="nudge_agent_view_kanban" model="ir.ui.view">
        <field name="name">nudge.agent.view.kanban</field>
        <field name="model">nudge.agent</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="false" group_delete="false" group_edit="false">
                <field name="name"/>
                <field name="role"/>
                <field name="state"/>
                <field name="score"/>
                <field name="answers_count"/>
                <field name="channels_label"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-3">
                            <field name="image_128" widget="image" options="{'img_class': 'rounded-circle', 'size': [56, 56]}"/>
                            <div class="flex-grow-1">
                                <div class="fw-bold fs-4"><field name="name"/></div>
                                <div class="text-muted"><field name="role"/></div>
                            </div>
                        </div>
                        <div class="mt-2 text-muted" t-if="record.channels_label.raw_value">
                            <field name="channels_label"/>
                        </div>
                        <div class="mt-1" t-if="record.score.raw_value">
                            <span class="text-muted">Score</span> <field name="score"/>%
                        </div>
                        <div class="mt-1" t-if="record.answers_count.raw_value">
                            <span class="text-muted">Answers</span> <field name="answers_count"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="nudge_agent_view_form" model="ir.ui.view">
        <field name="name">nudge.agent.view.form</field>
        <field name="model">nudge.agent</field>
        <field name="arch" type="xml">
            <form string="Agent">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state not in ('draft', 'tested')"/>
                    <button name="action_run_evaluation" type="object" string="Run evaluation"
                            invisible="state == 'archived'"/>
                    <button name="action_try_it" type="object" string="Try it" invisible="state == 'archived'"/>
                    <button name="action_access_preview" type="object" string="Access preview"/>
                    <button name="action_archive" type="object" string="Archive" invisible="state == 'archived'"/>
                    <button name="action_draft" type="object" string="Back to Draft"
                            invisible="state in ('draft', 'tested')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,tested,published" readonly="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="state != 'archived'"/>
                    <field name="active" invisible="1"/>
                    <field name="has_service_binding" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_conversations" type="object" class="oe_stat_button" icon="fa-comments">
                            <field name="answers_count" widget="statinfo" string="Answers"/>
                        </button>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Sales assistant"/></h1>
                        <h3><field name="role" placeholder="Answers questions about quotations and customers"/></h3>
                    </div>
                    <notebook>
                        <page string="Persona" name="persona">
                            <group>
                                <group>
                                    <field name="lang_ids" widget="many2many_tags"/>
                                    <field name="provider_id"/>
                                </group>
                                <group>
                                    <field name="greeting" placeholder="Hello, how can I help?"/>
                                </group>
                            </group>
                            <field name="instructions" nolabel="1"
                                   placeholder="How this agent speaks, what it focuses on, what it never does..."/>
                            <div class="text-muted">
                                Written in English, for the model. It is added on top of the rules of Nudge and never
                                replaces them: an agent cannot be told to ignore the safety rules, the rights of the
                                person, or the confirmation of a change.
                            </div>
                        </page>
                        <page string="Knowledge" name="knowledge">
                            <group>
                                <field name="skill_ids" widget="many2many_tags"/>
                                <field name="use_memory"/>
                                <field name="use_docs"/>
                            </group>
                            <div class="text-muted">
                                With no skill chosen, Nudge picks among the published skills as usual. Memory is only
                                what an approver accepted and the person may already read.
                            </div>
                        </page>
                        <page string="Abilities" name="abilities">
                            <group string="Who may use it">
                                <field name="company_ids" widget="many2many_tags"/>
                                <field name="group_ids" widget="many2many_tags"/>
                                <field name="user_ids" widget="many2many_tags"/>
                            </group>
                            <separator string="What it may do"/>
                            <field name="tool_keys" widget="nudge_agent_tools" nolabel="1"/>
                            <div class="text-muted">
                                The agent works under the rights of the person who talks to it: a tool is offered only
                                if that person may already use it. Changes always wait for a yes on a card.
                            </div>
                        </page>
                        <page string="Channels" name="channels">
                            <div class="alert alert-danger" role="alert" invisible="not has_service_binding">
                                A service binding lets the agent answer people who have no Odoo account, under a
                                restricted service user. Only an administrator can publish it. Read the
                                documentation (Nudge, Agents) before you do.
                            </div>
                            <field name="binding_ids" nolabel="1">
                                <tree decoration-danger="acts_as == 'service'">
                                    <field name="channel"/>
                                    <field name="acts_as"/>
                                    <field name="service_user_id" optional="show"/>
                                    <field name="escalation_user_id" optional="show"/>
                                    <field name="published"/>
                                </tree>
                                <form string="Channel">
                                    <div class="alert alert-danger" role="alert" invisible="acts_as != 'service'">
                                        This agent answers people who have no Odoo account, under the service user
                                        below. It sees only the models listed here, and only an administrator can
                                        publish it.
                                    </div>
                                    <group name="binding_main">
                                        <group name="binding_channel">
                                            <field name="channel"/>
                                            <field name="acts_as"/>
                                            <field name="published"/>
                                        </group>
                                        <group name="binding_service">
                                            <field name="service_user_id" invisible="acts_as != 'service'"/>
                                            <field name="model_allowlist" invisible="acts_as != 'service'"
                                                   placeholder="product.template, sale.order"/>
                                            <field name="escalation_user_id"/>
                                        </group>
                                    </group>
                                    <!-- Other modules add their fields here (nudge_discuss: the channels) -->
                                    <group name="binding_extra"/>
                                </form>
                            </field>
                        </page>
                        <page string="Guardrails" name="guardrails">
                            <group>
                                <group>
                                    <field name="mask_personal_data"/>
                                </group>
                                <group>
                                    <field name="budget_month"/>
                                    <field name="budget_user_day"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                A budget of 0 means no limit. Over a budget the agent still answers what needs no AI
                                (rules, memory) and says why it cannot do more.
                            </div>
                        </page>
                        <page string="Test" name="test">
                            <group>
                                <field name="score" widget="progressbar"/>
                            </group>
                            <field name="eval_ids" nolabel="1">
                                <tree editable="bottom" decoration-success="passed" decoration-danger="run_date and not passed">
                                    <field name="question"/>
                                    <field name="lang"/>
                                    <field name="expected"/>
                                    <field name="expected_text" invisible="expected != 'contains'"/>
                                    <field name="answer_shown" optional="show"/>
                                    <field name="last_source" optional="hide"/>
                                    <field name="passed"/>
                                    <field name="run_by" optional="hide"/>
                                    <field name="run_date" optional="hide"/>
                                </tree>
                            </field>
                            <div class="text-muted">
                                Run evaluation asks each question in rehearsal: changes are only described, nothing is
                                written, and the cost is not counted as real use. An agent is published only when every
                                question passes and the score is at least 80. The answers are given with the rights of
                                the one who runs the evaluation, and shown to them only.
                            </div>
                        </page>
                        <page string="Activity" name="activity">
                            <group>
                                <group>
                                    <field name="answers_count"/>
                                    <field name="no_ai_share"/>
                                    <field name="cost_month"/>
                                </group>
                            </group>
                            <button name="action_open_conversations" type="object" string="Open conversations"
                                    icon="fa-comments" class="btn-secondary"/>
                            <field name="revision_ids" nolabel="1" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="what"/>
                                </tree>
                                <form string="Change">
                                    <group>
                                        <field name="date"/>
                                        <field name="user_id"/>
                                        <field name="what"/>
                                    </group>
                                    <field name="diff_shown" class="font-monospace"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_agent_view_search" model="ir.ui.view">
        <field name="name">nudge.agent.view.search</field>
        <field name="model">nudge.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="role"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="tested" string="Tested" domain="[('state', '=', 'tested')]"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('state', '=', 'archived')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="nudge_agent_action" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">nudge.agent</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No agent yet</p>
            <p>
                An agent is a colleague with a role: its own instructions, skills, tools, companies and audience.
                It works under the rights of the person who talks to it. Test it in rehearsal, then publish it.
            </p>
        </field>
    </record>

    <menuitem id="nudge_menu_agents" name="Agents" sequence="5"
              parent="nudge_menu_configuration" action="nudge_agent_action"
              groups="nudge.group_nudge_manager"/>
</odoo>
