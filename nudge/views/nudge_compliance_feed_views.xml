<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_compliance_notice_list" model="ir.ui.view">
        <field name="name">nudge.compliance.notice.list</field>
        <field name="model">nudge.compliance.notice</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="deadline"/>
                <field name="days_left"/>
                <field name="title"/>
                <field name="pack"/>
                <field name="threshold" string="Told at (days)"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="notified_on"/>
            </tree>
        </field>
    </record>

    <record id="nudge_compliance_notice_action" model="ir.actions.act_window">
        <field name="name">Compliance Deadlines</field>
        <field name="res_model">nudge.compliance.notice</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No deadline has been told yet</p>
            <p>Managers are told 90, 30 and 7 days before a date in the checklist of their country, and 60, 30 and 7 days before a certificate or credential expires. What was told is listed here.</p>
        </field>
    </record>

    <record id="nudge_compliance_update_list" model="ir.ui.view">
        <field name="name">nudge.compliance.update.list</field>
        <field name="model">nudge.compliance.update</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" decoration-info="state == 'pending'" decoration-muted="state in ('superseded', 'rejected', 'rolled_back')">
                <field name="pack_id"/>
                <field name="issued"/>
                <field name="state"/>
                <field name="approved_by"/>
                <field name="approved_on"/>
            </tree>
        </field>
    </record>

    <record id="nudge_compliance_update_form" model="ir.ui.view">
        <field name="name">nudge.compliance.update.form</field>
        <field name="model">nudge.compliance.update</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'pending'" groups="base.group_system"
                            confirm="This replaces the checklist of this country by the one below."/>
                    <button name="action_reject" type="object" string="Decline"
                            invisible="state != 'pending'" groups="base.group_system"/>
                    <button name="action_rollback" type="object" string="Roll back"
                            invisible="state != 'applied'" groups="base.group_system"
                            confirm="The previous pack, or the one that comes with Nudge, is put back."/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,applied"/>
                </header>
                <sheet>
                    <group>
                        <field name="pack_id"/>
                        <field name="issued"/>
                        <field name="approved_by"/>
                        <field name="approved_on"/>
                    </group>
                    <group string="What Changes">
                        <field name="diff" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_compliance_update_action" model="ir.actions.act_window">
        <field name="name">Compliance Pack Updates</field>
        <field name="res_model">nudge.compliance.update</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pack update</p>
            <p>The signed feed is off until an administrator sets its address and public key in the Nudge settings. An update waits here until an administrator approves it.</p>
        </field>
    </record>

    <record id="nudge_credential_list" model="ir.ui.view">
        <field name="name">nudge.credential.list</field>
        <field name="model">nudge.credential</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-danger="days_left &lt; 0" decoration-warning="0 &lt;= days_left and days_left &lt;= 30">
                <field name="name"/>
                <field name="expiry_date"/>
                <field name="days_left"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="nudge_credential_action" model="ir.actions.act_window">
        <field name="name">Credential Expiry</field>
        <field name="res_model">nudge.credential</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No credential to watch</p>
            <p>Enter the name and the expiry date of a token or registration that Odoo does not store, such as an ETA token or a Peppol registration. Managers are told 60, 30 and 7 days before and on the day. The ZATCA certificate and the certificates of Odoo are watched by themselves. Only dates are kept here: never type the secret.</p>
        </field>
    </record>

    <menuitem id="nudge_menu_health_compliance_deadlines" name="Compliance Deadlines" sequence="16"
              parent="nudge_menu_health" action="nudge_compliance_notice_action"/>
    <menuitem id="nudge_menu_health_compliance_updates" name="Compliance Pack Updates" sequence="17"
              parent="nudge_menu_advanced" action="nudge_compliance_update_action" groups="base.group_system"/>
    <menuitem id="nudge_menu_health_credentials" name="Credential Expiry" sequence="18"
              parent="nudge_menu_advanced" action="nudge_credential_action"/>
</odoo>
