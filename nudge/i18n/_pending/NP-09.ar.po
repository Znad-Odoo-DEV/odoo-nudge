# Arabic translation of the prompts that come with Nudge (NP-09), to be merged into ar.po by the lead.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8
"
"Language: ar
"

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_talk_screen_next_step
msgid "What do I do next on this screen?"
msgstr "ما الخطوة التالية في هذه الشاشة؟"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_talk_screen_next_step
msgid "Reads the shared screen and points at the next field or button."
msgstr "يقرأ الشاشة المعروضة ويشير إلى الحقل أو الزر التالي."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_talk_screen_next_step
msgid "Look at my screen. Tell me what is still missing before I can save or confirm this {{record_kind}}, and show me the next field or button on the screen, one step at a time."
msgstr "انظر إلى شاشتي. قل لي ما الذي ينقص قبل أن أحفظ أو أؤكد هذا {{record_kind}}، وأشر لي على الحقل أو الزر التالي على الشاشة خطوة بخطوة."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_talk_sales_flow
msgid "Explain the sales flow for my products"
msgstr "اشرح دورة المبيعات لمنتجاتي"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_talk_sales_flow
msgid "Quotation to invoice, as this database is set up (not generic Odoo)."
msgstr "من عرض السعر إلى الفاتورة كما هي مضبوطة في قاعدة البيانات هذه."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_talk_sales_flow
msgid "Explain, as this database is set up, the path of a sale of {{product_type}} from quotation to payment: which documents are created, which settings change the path (delivery, invoicing policy), and who does each step. Read the settings first; do not describe options that are switched off."
msgstr "اشرح كما هي قاعدة البيانات مضبوطة مسار بيع {{product_type}} من عرض السعر حتى الدفع: ما المستندات التي تُنشأ، وما الإعدادات التي تغيّر المسار (التسليم، سياسة الفوترة)، ومن ينفذ كل خطوة. اقرأ الإعدادات أولاً ولا تشرح خيارات غير مفعّلة."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_talk_bank_reconcile
msgid "Walk me through bank reconciliation"
msgstr "علّمني تسوية البنك"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_talk_bank_reconcile
msgid "Pointer tour of the reconciliation screen with the person's own journal."
msgstr "جولة بالمؤشر على شاشة التسوية بدفتر الشخص نفسه."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_talk_bank_reconcile
msgid "Show me on screen how to reconcile the bank statement lines of the journal {{journal}}: where to match an invoice, how to write off a small difference, and how to leave a line for later."
msgstr "أرني على الشاشة كيف أسوّي سطور كشف البنك لدفتر {{journal}}: أين أطابق فاتورة، وكيف أشطب فرقاً صغيراً، وكيف أترك سطراً لوقت لاحق."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_talk_negative_stock
msgid "Why is this product's stock negative?"
msgstr "لماذا مخزون هذا المنتج بالسالب؟"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_talk_negative_stock
msgid "Traces the moves that pushed the on-hand quantity below zero."
msgstr "يتتبع الحركات التي جعلت الكمية المتاحة أقل من صفر."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_talk_negative_stock
msgid "The on-hand quantity of {{product}} is negative in {{warehouse}}. Read its stock moves of the last {{days}} days and tell me which deliveries left before the receipts arrived, and what setting allows it. Answer with a short table: date, document, quantity, running balance."
msgstr "الكمية المتاحة من {{product}} سالبة في {{warehouse}}. اقرأ حركات المخزون لآخر {{days}} يوماً وقل لي أي التسليمات خرجت قبل وصول الاستلامات، وأي إعداد يسمح بذلك. أجب بجدول قصير: التاريخ، المستند، الكمية، الرصيد التراكمي."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_talk_setup_advisor
msgid "Which settings fit my business?"
msgstr "ما الإعدادات المناسبة لنشاطي؟"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_talk_setup_advisor
msgid "Setup advisor: reads the settings and suggests what to switch on, without changing anything."
msgstr "مستشار الإعداد: يقرأ الإعدادات ويقترح ما يُفعّل دون أن يغيّر شيئاً."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_talk_setup_advisor
msgid "We are a {{business_type}} with about {{employees}} employees, selling in {{country}}. Read how {{app}} is set up here and tell me what to switch on, what to leave off and why, in a short list. Change nothing; at the end offer to apply it or to show me where."
msgstr "نحن {{business_type}} لدينا نحو {{employees}} موظفاً ونبيع في {{country}}. اقرأ كيف ضُبط تطبيق {{app}} هنا وقل لي ما يُفعَّل وما يُترك ولماذا، في قائمة قصيرة. لا تغيّر شيئاً، وفي النهاية اعرض عليّ أن تطبقه أو أن تريني مكانه."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_talk_import_check
msgid "Will this file import?"
msgstr "هل سيُستورد هذا الملف؟"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_talk_import_check
msgid "Dry-run import check of an attached file, problems by row and column."
msgstr "فحص تجريبي لملف مرفق قبل الاستيراد، المشاكل حسب الصف والعمود."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_talk_import_check
msgid "Check the attached file before I import it into {{target}}. Match its columns to the fields, test it without saving, and list every problem with its row and column and how to fix it in the file."
msgstr "افحص الملف المرفق قبل أن أستورده إلى {{target}}. طابق أعمدته مع الحقول، وجرّبه دون حفظ، واذكر كل مشكلة مع رقم الصف والعمود وكيف أصلحها في الملف."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_talk_leave_policy
msgid "How does our time off work?"
msgstr "كيف تعمل الإجازات عندنا؟"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_talk_leave_policy
msgid "Explains allocation, accrual and approval of one leave type as configured."
msgstr "يشرح التخصيص والاستحقاق والموافقة لنوع إجازة كما هو مضبوط."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_talk_leave_policy
msgid "Explain how the time off type {{leave_type}} works in your company: how days are allocated or accrued, who approves, and what an employee like Raghad sees when she asks for it. Use our company files if they describe the policy, and say which part comes from them."
msgstr "اشرح كيف يعمل نوع الإجازة {{leave_type}} في شركتك: كيف تُخصَّص الأيام أو تُستحق، ومن يوافق، وماذا ترى موظفة مثل رغد عندما تطلبها. استعن بملفات الشركة إن كانت تشرح السياسة، واذكر أي جزء أُخذ منها."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_talk_explain_term
msgid "Explain this term in plain words"
msgstr "اشرح هذا المصطلح ببساطة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_talk_explain_term
msgid "Explains an Odoo term or field with an example from this database."
msgstr "يشرح مصطلحاً أو حقلاً في أودو بمثال من قاعدة البيانات هذه."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_talk_explain_term
msgid "Explain \"{{term}}\" in plain business words, in three sentences, with one example taken from this database. Then tell me where I meet it on screen."
msgstr "اشرح \"{{term}}\" بلغة عمل بسيطة في ثلاث جمل، مع مثال واحد من قاعدة البيانات هذه، ثم قل لي أين أجده على الشاشة."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_overdue_followup
msgid "Follow up overdue invoices"
msgstr "متابعة الفواتير المتأخرة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_overdue_followup
msgid "Lists overdue customer invoices and prepares one follow-up activity per customer, after a yes."
msgstr "يعرض فواتير العملاء المتأخرة ويجهّز نشاط متابعة لكل عميل بعد الموافقة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_overdue_followup
msgid "Find posted customer invoices overdue by more than {{days}} days. Group them by customer with the total due and the oldest due date, as a table. Then prepare one activity \"Call about overdue invoices\" per customer for {{assignee}}, due {{due}}, in one card for my approval."
msgstr "ابحث عن فواتير العملاء المرحّلة المتأخرة أكثر من {{days}} يوماً. اجمعها حسب العميل مع إجمالي المستحق وأقدم تاريخ استحقاق، في جدول. ثم جهّز نشاطاً واحداً \"اتصال بخصوص الفواتير المتأخرة\" لكل عميل باسم {{assignee}} بتاريخ {{due}}، في بطاقة واحدة لموافقتي."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_quote_from_text
msgid "Make a quotation from my words"
msgstr "أنشئ عرض سعر من كلامي"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_quote_from_text
msgid "Drafts a quotation with lines; nothing is created before the card's yes."
msgstr "يجهّز عرض سعر بسطوره؛ لا يُنشأ شيء قبل الموافقة على البطاقة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_quote_from_text
msgid "Prepare a quotation for {{customer}}: {{lines}}. Use the customer's pricelist and payment terms, find each product by the name I used, and ask me when two products match. Show me the card before creating it."
msgstr "جهّز عرض سعر للعميل {{customer}}: {{lines}}. استخدم قائمة أسعار العميل وشروط الدفع الخاصة به، وابحث عن كل منتج بالاسم الذي استخدمته، واسألني إذا تطابق منتجان. أرني البطاقة قبل الإنشاء."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_reorder_low_stock
msgid "Reorder what is running low"
msgstr "أعد طلب ما قارب على النفاد"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_reorder_low_stock
msgid "Finds products under a threshold and prepares draft RFQs grouped by vendor."
msgstr "يجد المنتجات تحت حد معيّن ويجهّز طلبات عروض أسعار مسودة مجمعة حسب المورد."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_reorder_low_stock
msgid "List storable products in {{category}} whose forecasted quantity is below {{min_qty}}, with their main vendor and last purchase price. Then prepare one draft request for quotation per vendor, quantity = {{order_up_to}} minus forecast, for my approval. Do not confirm any order."
msgstr "اعرض المنتجات المخزنية في {{category}} التي كميتها المتوقعة أقل من {{min_qty}}، مع المورد الرئيسي وآخر سعر شراء. ثم جهّز طلب عرض سعر مسودة لكل مورد، الكمية = {{order_up_to}} ناقص المتوقع، لموافقتي. لا تؤكد أي أمر شراء."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_stale_opportunities
msgid "Wake up stale opportunities"
msgstr "أنعش الفرص الراكدة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_stale_opportunities
msgid "Opportunities with no activity for N days; one call activity each, one approval."
msgstr "الفرص التي لا نشاط عليها منذ N يوماً؛ نشاط اتصال لكل منها بموافقة واحدة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_stale_opportunities
msgid "Find open opportunities of the team {{team}} with no activity and no message for {{days}} days. Show them by salesperson with expected revenue. Then schedule a \"Call\" activity on each for its salesperson, due in {{in_days}} days, all in one card."
msgstr "ابحث عن الفرص المفتوحة لفريق {{team}} التي لا نشاط ولا رسالة عليها منذ {{days}} يوماً. اعرضها حسب مندوب المبيعات مع الإيراد المتوقع. ثم جدول نشاط \"اتصال\" على كل منها لمندوبها بعد {{in_days}} أيام، كلها في بطاقة واحدة."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_project_status
msgid "Weekly project status"
msgstr "حالة المشروع الأسبوعية"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_project_status
msgid "Overdue and due-this-week tasks of one project, as a table saved to My Reports."
msgstr "المهام المتأخرة والمستحقة هذا الأسبوع لمشروع واحد، كجدول يُحفظ في تقاريري."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_project_status
msgid "For the project {{project}}: tasks overdue, tasks due this week, and tasks with no assignee, each as a short table (task, assignee, deadline, stage). Add one line on what blocks the most. Save it to My Reports as \"{{project}} weekly status\"."
msgstr "للمشروع {{project}}: المهام المتأخرة، والمستحقة هذا الأسبوع، والتي بلا مسؤول، كل منها في جدول قصير (المهمة، المسؤول، الموعد النهائي، المرحلة). أضف سطراً عن أكثر ما يعيق العمل. احفظه في تقاريري باسم \"الحالة الأسبوعية لـ {{project}}\"."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_stock_value_chart
msgid "Stock value by category"
msgstr "قيمة المخزون حسب الفئة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_stock_value_chart
msgid "Sum of stock value by category and warehouse, as a chart."
msgstr "مجموع قيمة المخزون حسب الفئة والمستودع، كرسم بياني."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_stock_value_chart
msgid "Sum the stock value on hand by product category and by warehouse, top {{top}} categories, as a bar chart, with the total in the currency of your company. Say which valuation the figures use."
msgstr "اجمع قيمة المخزون المتاح حسب فئة المنتج وحسب المستودع، لأعلى {{top}} فئات، كرسم بياني بالأعمدة، مع الإجمالي بعملة شركتك. اذكر طريقة التقييم التي تعتمدها الأرقام."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_onboard_employee
msgid "Onboard a new employee"
msgstr "استقبال موظف جديد"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_onboard_employee
msgid "Creates the employee and the onboarding activities in one plan, after a yes."
msgstr "ينشئ الموظف وأنشطة الاستقبال في خطة واحدة بعد الموافقة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_onboard_employee
msgid "Prepare the onboarding of {{employee_name}}, {{job}} in {{department}}, starting {{start}}: create the employee with manager {{manager}}, then activities for IT (laptop, email), HR (contract, documents) and the manager (first-week plan). One plan, one card."
msgstr "جهّز استقبال {{employee_name}}، {{job}} في قسم {{department}}، بدءاً من {{start}}: أنشئ الموظف ومديره {{manager}}، ثم أنشطة لتقنية المعلومات (جهاز، بريد)، والموارد البشرية (العقد، المستندات)، والمدير (خطة الأسبوع الأول). خطة واحدة وبطاقة واحدة."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_bill_from_pdf
msgid "Vendor bill from this PDF"
msgstr "فاتورة مورد من هذا الملف"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_bill_from_pdf
msgid "Reads the attached vendor PDF into a draft bill; lines checked against products."
msgstr "يقرأ ملف المورد المرفق إلى فاتورة مسودة مع مطابقة السطور بالمنتجات."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_bill_from_pdf
msgid "Read the attached vendor document and prepare a draft vendor bill: vendor, bill reference, date, due date, lines with product, quantity, price and taxes. Flag any line whose price differs by more than {{tolerance}}% from the last purchase price. Leave it in draft."
msgstr "اقرأ مستند المورد المرفق وجهّز فاتورة مورد مسودة: المورد، مرجع الفاتورة، التاريخ، تاريخ الاستحقاق، السطور بالمنتج والكمية والسعر والضرائب. نبّهني إلى أي سطر يختلف سعره بأكثر من {{tolerance}}% عن آخر سعر شراء. اتركها مسودة."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_monthly_sales_kpi
msgid "This month's sales by salesperson"
msgstr "مبيعات هذا الشهر حسب المندوب"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_monthly_sales_kpi
msgid "This month vs last month per salesperson, chart + saved report."
msgstr "هذا الشهر مقابل الشهر الماضي لكل مندوب، رسم وتقرير محفوظ."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_monthly_sales_kpi
msgid "Compare confirmed sales of this month with last month, per salesperson: amount untaxed, number of orders, change in %. Show a bar chart and save it to My Reports{{home}}."
msgstr "قارن المبيعات المؤكدة لهذا الشهر بالشهر الماضي لكل مندوب: المبلغ قبل الضريبة، عدد الطلبات، نسبة التغير. اعرض رسماً بالأعمدة واحفظه في تقاريري{{home}}."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_duplicate_contacts
msgid "Find duplicate contacts"
msgstr "ابحث عن جهات الاتصال المكررة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_duplicate_contacts
msgid "Lists likely duplicates by email, phone or name; changes nothing (merge stays manual)."
msgstr "يعرض التكرارات المحتملة حسب البريد أو الهاتف أو الاسم؛ لا يغيّر شيئاً."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_duplicate_contacts
msgid "Find contacts that are probably the same person or company: same email, same phone digits, or names that differ only by spaces or case. List them in groups with their number of sales orders and invoices, so I can decide which to keep. Change nothing."
msgstr "ابحث عن جهات الاتصال التي غالباً تخص الشخص أو الشركة نفسها: البريد نفسه، أرقام الهاتف نفسها، أو أسماء لا تختلف إلا بالمسافات أو حالة الأحرف. اعرضها في مجموعات مع عدد أوامر البيع والفواتير لكل منها لأقرر أيها أبقي. لا تغيّر شيئاً."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_morning_brief_task
msgid "My morning brief, every working day"
msgstr "ملخصي الصباحي كل يوم عمل"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_morning_brief_task
msgid "Creates a scheduled task (switched on after a yes) that writes the brief each morning."
msgstr "ينشئ مهمة مجدولة (تُفعّل بعد الموافقة) تكتب الملخص كل صباح."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_morning_brief_task
msgid "Every working day at {{hour}}:00, tell me: my activities due today, quotations expiring this week, invoices that became overdue yesterday, and anything assigned to me since yesterday. Make it a scheduled task{{email}}."
msgstr "كل يوم عمل الساعة {{hour}}:00 قل لي: أنشطتي المستحقة اليوم، وعروض الأسعار التي تنتهي هذا الأسبوع، والفواتير التي تأخرت أمس، وكل ما أُسند إليّ منذ أمس. اجعلها مهمة مجدولة{{email}}."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_agent_pos_day_close
msgid "Point of Sale: today's close"
msgstr "نقاط البيع: إقفال اليوم"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_agent_pos_day_close
msgid "Sales of the day by payment method and by hour, with refunds and discounts."
msgstr "مبيعات اليوم حسب طريقة الدفع والساعة، مع المرتجعات والخصومات."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_agent_pos_day_close
msgid "For the point of sale {{pos}}, today: total sales, number of orders, average ticket, totals by payment method, refunds and discounts given, and sales by hour as a chart. Note any cash difference of the closed sessions."
msgstr "لنقطة البيع {{pos}} اليوم: إجمالي المبيعات، عدد الطلبات، متوسط الفاتورة، الإجمالي حسب طريقة الدفع، المرتجعات والخصومات، والمبيعات حسب الساعة كرسم بياني. اذكر أي فرق نقدي في الجلسات المقفلة."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_dev_big_order_alert
msgid "Alert on big confirmed orders"
msgstr "تنبيه عند تأكيد طلب كبير"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_dev_big_order_alert
msgid "Automation rule + email, tested on a dummy record before it is switched on."
msgstr "قاعدة أتمتة مع بريد، تُجرّب على سجل تجريبي قبل التفعيل."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_dev_big_order_alert
msgid "When a sales order above {{amount}} is confirmed, email {{recipient}} with the customer, the amount, the salesperson and a link to the order. Build it as an automation rule, try it on a dummy record, and show me what it would send before switching it on."
msgstr "عند تأكيد أمر بيع أكبر من {{amount}}، أرسل بريداً إلى {{recipient}} فيه العميل والمبلغ والمندوب ورابط الأمر. ابنها كقاعدة أتمتة، جرّبها على سجل تجريبي، وأرني ما سترسله قبل تفعيلها."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_dev_add_field
msgid "Add a field to a form"
msgstr "أضف حقلاً إلى نموذج"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_dev_add_field
msgid "New field + view change, previewed, undoable."
msgstr "حقل جديد مع تعديل العرض، بمعاينة وإمكانية تراجع."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_dev_add_field
msgid "Add a field \"{{label}}\" of type {{type}} to {{model}}, shown on the form after the field {{after}}{{list}}. Show me the change before making it."
msgstr "أضف حقلاً \"{{label}}\" من نوع {{type}} إلى {{model}}، يظهر في النموذج بعد الحقل {{after}}{{list}}. أرني التغيير قبل تنفيذه."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_dev_purchase_approval
msgid "Approval for big purchases"
msgstr "موافقة على المشتريات الكبيرة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_dev_purchase_approval
msgid "Approval workflow from one sentence: threshold, approver group, button guard."
msgstr "مسار موافقة من جملة واحدة: الحد، مجموعة الموافِق، حماية الزر."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_dev_purchase_approval
msgid "Purchase orders above {{amount}} must be approved by {{approver}} before they can be confirmed. The buyer sees why the button is blocked; the approver gets an activity. Build it and test it on a dummy order."
msgstr "أوامر الشراء التي تتجاوز {{amount}} يجب أن يوافق عليها {{approver}} قبل تأكيدها. يرى المشتري سبب منع الزر، ويصل للموافِق نشاط. ابنِها وجرّبها على أمر تجريبي."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_dev_quote_followup_email
msgid "Designed follow-up email for quotations"
msgstr "بريد متابعة مصمم لعروض الأسعار"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_dev_quote_followup_email
msgid "Email template in one of four styles + the reviewer's check."
msgstr "قالب بريد بأحد أربعة أنماط مع فحص المراجعة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_dev_quote_followup_email
msgid "Design a {{style}} email template for quotations sent {{days}} days ago and not answered: the customer's first name, the quotation number and total, a button to view it online, and a short polite line. In English and Arabic. Review it, then send me a test."
msgstr "صمّم قالب بريد بنمط {{style}} لعروض الأسعار المرسلة منذ {{days}} أيام دون رد: الاسم الأول للعميل، رقم العرض وإجماليه، زر لعرضه عبر الإنترنت، وسطر مهذب قصير. بالعربية والإنجليزية. راجعه ثم أرسل لي نسخة تجريبية."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_dev_archive_lost_leads
msgid "Archive old lost leads every month"
msgstr "أرشفة العملاء المحتملين الخاسرين شهرياً"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_dev_archive_lost_leads
msgid "Scheduled action that archives (never deletes) lost leads older than N months."
msgstr "إجراء مجدول يؤرشف (ولا يحذف) العملاء الخاسرين الأقدم من N شهراً."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_dev_archive_lost_leads
msgid "Every month, archive the leads and opportunities marked lost more than {{months}} months ago. Never delete them. Show me how many it would archive today before you build it."
msgstr "كل شهر، أرشف العملاء المحتملين والفرص المسجلة كخاسرة منذ أكثر من {{months}} شهراً. لا تحذفها أبداً. أرني كم ستؤرشف اليوم قبل أن تبنيها."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_dev_bilingual_delivery_slip
msgid "Bilingual delivery slip"
msgstr "إذن تسليم بلغتين"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_dev_bilingual_delivery_slip
msgid "Printed report design, Arabic + English, right-to-left aware."
msgstr "تصميم تقرير مطبوع بالعربية والإنجليزية مع مراعاة الاتجاه من اليمين لليسار."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_dev_bilingual_delivery_slip
msgid "Design the delivery slip in Arabic and English side by side: your company's logo, the customer, the lines with product, quantity and unit, and a signature box for the receiver{{extra}}. Arabic on the right. Show me a preview on a real delivery first."
msgstr "صمّم إذن التسليم بالعربية والإنجليزية جنباً إلى جنب: شعار شركتك، العميل، السطور بالمنتج والكمية والوحدة، وخانة توقيع للمستلم{{extra}}. العربية على اليمين. أرني معاينة على تسليم حقيقي أولاً."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_dev_why_failed
msgid "Why did this automation fail?"
msgstr "لماذا فشلت هذه الأتمتة؟"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_dev_why_failed
msgid "Reads the logs and the rule, explains the failure, proposes a fix as a card."
msgstr "يقرأ السجلات والقاعدة ويشرح الفشل ويقترح إصلاحاً في بطاقة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_dev_why_failed
msgid "The automation \"{{name}}\" did not run as expected on {{record}}. Read what runs on this model, find why it failed or did not trigger, explain it in two sentences, and propose the fix as a change I can approve."
msgstr "الأتمتة \"{{name}}\" لم تعمل كما يجب على {{record}}. اقرأ ما يعمل تلقائياً على هذا النموذج، واعرف لماذا فشلت أو لم تنطلق، واشرح ذلك في جملتين، واقترح الإصلاح كتغيير أوافق عليه."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_ind_contracting_cost_vs_budget
msgid "Contracting: projects over budget"
msgstr "المقاولات: المشاريع التي تجاوزت الميزانية"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_ind_contracting_cost_vs_budget
msgid "Costs (timesheets, vendor bills, stock) vs the contract amount per project."
msgstr "التكاليف (ساعات العمل، فواتير الموردين، المخزون) مقابل قيمة العقد لكل مشروع."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_ind_contracting_cost_vs_budget
msgid "For each active project, compare its costs so far (analytic lines of timesheets, vendor bills and stock moves) with the amount of its sales order. List the projects above {{percent}}% of the contract amount, with progress of the tasks, as a table sorted by risk."
msgstr "لكل مشروع نشط، قارن تكاليفه حتى الآن (القيود التحليلية لساعات العمل وفواتير الموردين وحركات المخزون) مع مبلغ أمر البيع الخاص به. اعرض المشاريع التي تجاوزت {{percent}}% من قيمة العقد مع نسبة إنجاز المهام، في جدول مرتب حسب الخطورة."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_ind_restaurant_menu_margin
msgid "Restaurant: menu items by margin"
msgstr "المطاعم: أصناف القائمة حسب الهامش"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_ind_restaurant_menu_margin
msgid "POS sales of the last N days per menu item with cost and margin."
msgstr "مبيعات نقاط البيع لآخر N يوماً لكل صنف مع التكلفة والهامش."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_ind_restaurant_menu_margin
msgid "For the last {{days}} days of the point of sale, list each menu item with quantity sold, revenue, cost (from its bill of materials or cost price) and margin %. Show the {{top}} best and {{top}} worst by margin as a chart."
msgstr "لآخر {{days}} يوماً في نقطة البيع، اعرض كل صنف في القائمة مع الكمية المباعة والإيراد والتكلفة (من قائمة المواد أو سعر التكلفة) ونسبة الهامش. اعرض أفضل {{top}} وأسوأ {{top}} حسب الهامش في رسم بياني."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_ind_clinic_tomorrow_reminders
msgid "Clinic: remind tomorrow's patients"
msgstr "العيادة: تذكير مواعيد الغد"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_ind_clinic_tomorrow_reminders
msgid "Tomorrow's calendar appointments → draft reminder messages, sent only after a yes."
msgstr "مواعيد الغد في التقويم ← رسائل تذكير مسودة، تُرسل فقط بعد الموافقة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_ind_clinic_tomorrow_reminders
msgid "List tomorrow's appointments in the calendar of {{doctor}} with the patient, time and phone. Prepare a short reminder for each in the patient's language (Arabic or English) with the time and the address of your company, and show me the list before anything is sent."
msgstr "اعرض مواعيد الغد في تقويم {{doctor}} مع اسم المريض والوقت والهاتف. جهّز تذكيراً قصيراً لكل مريض بلغته (العربية أو الإنجليزية) فيه الوقت وعنوان شركتك، وأرني القائمة قبل إرسال أي شيء."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_ind_retail_slow_movers
msgid "Retail: slow movers in stock"
msgstr "التجزئة: الأصناف بطيئة الحركة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_ind_retail_slow_movers
msgid "In-stock products with no sale for N days, with stock value tied up."
msgstr "المنتجات المتوفرة التي لم تُبع منذ N يوماً مع قيمة المخزون المجمّد."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_ind_retail_slow_movers
msgid "List products with stock on hand that have not been sold (sales or point of sale) in the last {{days}} days, with quantity, stock value and last sale date, sorted by value. Suggest which could go on a promotion, and save the list to My Reports."
msgstr "اعرض المنتجات المتوفرة في المخزون التي لم تُبع (مبيعات أو نقاط بيع) خلال آخر {{days}} يوماً، مع الكمية وقيمة المخزون وتاريخ آخر بيع، مرتبة حسب القيمة. اقترح ما يصلح لعرض ترويجي، واحفظ القائمة في تقاريري."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_ind_coffee_seasonal_reorder
msgid "Coffee supplies: seasonal reorder"
msgstr "مستلزمات القهوة: إعادة طلب موسمية"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_ind_coffee_seasonal_reorder
msgid "Average monthly sales of beans, cups and syrups vs stock → months of cover."
msgstr "متوسط المبيعات الشهرية للبن والأكواب والنكهات مقابل المخزون ← أشهر التغطية."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_ind_coffee_seasonal_reorder
msgid "For the categories {{categories}}, compute the average monthly quantity sold over the last {{months}} months and the same month last year, then the months of cover of the current stock. List what has less than {{cover}} months of cover, with the main vendor and lead time."
msgstr "للفئات {{categories}}، احسب متوسط الكمية المباعة شهرياً خلال آخر {{months}} أشهر ونفس الشهر من العام الماضي، ثم عدد أشهر التغطية للمخزون الحالي. اعرض ما تغطيته أقل من {{cover}} شهر، مع المورد الرئيسي ومدة التوريد."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_ind_real_estate_unit_interest
msgid "Real estate: available units and interested leads"
msgstr "العقارات: الوحدات المتاحة والمهتمون"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_ind_real_estate_unit_interest
msgid "Units (products tagged as units) not yet sold, matched to open leads by tag and budget."
msgstr "الوحدات (منتجات موسومة كوحدات) غير المباعة، مطابقة مع العملاء المحتملين حسب الوسم والميزانية."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_ind_real_estate_unit_interest
msgid "List the units of the project {{project_tag}} that are still available (not on a confirmed sales order), with type, area and price. For each, show the open leads tagged {{project_tag}} whose expected revenue is within {{margin}}% of the price, and who handles them."
msgstr "اعرض وحدات المشروع {{project_tag}} التي ما زالت متاحة (ليست في أمر بيع مؤكد) مع النوع والمساحة والسعر. ولكل وحدة اعرض العملاء المحتملين المفتوحين الموسومين {{project_tag}} الذين يقع إيرادهم المتوقع ضمن {{margin}}% من السعر، ومن يتابعهم."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_role_ceo_weekly
msgid "CEO: the week in one table"
msgstr "المدير العام: الأسبوع في جدول واحد"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_role_ceo_weekly
msgid "Revenue, cash, receivables, payables, pipeline, with last week for comparison."
msgstr "الإيراد والنقد والذمم المدينة والدائنة والفرص، مقارنة بالأسبوع الماضي."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_role_ceo_weekly
msgid "Give me the week of your company in one table, this week vs last week: invoiced revenue, cash in bank, receivables overdue, payables due in 7 days, new opportunities and their value, confirmed sales. Then three lines: what improved, what worsened, what needs a decision."
msgstr "أعطني أسبوع شركتك في جدول واحد، هذا الأسبوع مقابل الماضي: الإيراد المفوتر، النقد في البنك، الذمم المدينة المتأخرة، الذمم الدائنة المستحقة خلال 7 أيام، الفرص الجديدة وقيمتها، المبيعات المؤكدة. ثم ثلاثة أسطر: ما تحسّن، وما تراجع، وما يحتاج قراراً."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_role_accountant_month_end
msgid "Accountant: month-end checklist"
msgstr "المحاسب: قائمة إقفال الشهر"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_role_accountant_month_end
msgid "What blocks closing the month: drafts, unreconciled lines, missing bills."
msgstr "ما يمنع إقفال الشهر: المسودات، السطور غير المسوّاة، الفواتير الناقصة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_role_accountant_month_end
msgid "Before I close {{month}}: count draft journal entries and draft bills dated in it, unreconciled bank lines, customer payments not matched, receipts without a vendor bill, and the lock date now set. One checklist line each, with Show me links."
msgstr "قبل أن أقفل شهر {{month}}: احسب القيود والفواتير المسودة المؤرخة فيه، وسطور البنك غير المسوّاة، ودفعات العملاء غير المطابقة، والاستلامات بلا فاتورة مورد، وتاريخ الإقفال الحالي. سطر لكل بند مع رابط \"أرني\"."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_role_sales_my_day
msgid "Salesperson: my day"
msgstr "مندوب المبيعات: يومي"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_role_sales_my_day
msgid "My activities, quotations expiring soon, customers waiting for an answer."
msgstr "أنشطتي، عروض الأسعار التي تنتهي قريباً، العملاء الذين ينتظرون رداً."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_role_sales_my_day
msgid "What is waiting for me today: my activities due or late, my quotations expiring in {{days}} days, and customers whose last message to me has no answer. Shortest list first, with Show me links."
msgstr "ما الذي ينتظرني اليوم: أنشطتي المستحقة أو المتأخرة، عروض أسعاري التي تنتهي خلال {{days}} أيام، والعملاء الذين لم أرد على آخر رسالة لهم. ابدأ بالقائمة الأقصر، مع روابط \"أرني\"."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_role_warehouse_late_receipts
msgid "Warehouse: late receipts"
msgstr "المستودع: الاستلامات المتأخرة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_role_warehouse_late_receipts
msgid "Receipts past their scheduled date, by vendor, with what they block."
msgstr "الاستلامات التي تجاوزت موعدها، حسب المورد، مع ما تعطّله."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_role_warehouse_late_receipts
msgid "List incoming receipts late by more than {{days}} days, by vendor: reference, scheduled date, products, and the customer orders waiting for those products. Prepare a reminder activity on each purchase order for its buyer, for my approval."
msgstr "اعرض الاستلامات الواردة المتأخرة أكثر من {{days}} أيام حسب المورد: المرجع، الموعد المجدول، المنتجات، وطلبات العملاء التي تنتظر هذه المنتجات. جهّز نشاط تذكير على كل أمر شراء لمسؤول الشراء، لموافقتي."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_role_hr_contracts_ending
msgid "HR: contracts ending soon"
msgstr "الموارد البشرية: عقود تنتهي قريباً"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_role_hr_contracts_ending
msgid "Employees whose contract ends within N days, with a renewal activity each."
msgstr "الموظفون الذين تنتهي عقودهم خلال N يوماً، مع نشاط تجديد لكل منهم."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_role_hr_contracts_ending
msgid "Which employees have a contract ending within {{days}} days? Show name, department, end date and manager. Then prepare a \"Renewal decision\" activity for each manager, in one card."
msgstr "من الموظفون الذين تنتهي عقودهم خلال {{days}} يوماً؟ اعرض الاسم والقسم وتاريخ الانتهاء والمدير. ثم جهّز نشاط \"قرار التجديد\" لكل مدير في بطاقة واحدة."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_web_restaurant
msgid "Website: restaurant"
msgstr "موقع: مطعم"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_web_restaurant
msgid "Opens the Website Builder interview pre-filled for restaurant (template restaurant); pages stay unpublished."
msgstr "يفتح مقابلة منشئ المواقع معبأة مسبقاً لهذا النشاط؛ تبقى الصفحات غير منشورة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_web_restaurant
msgid "Build a website for your company, a restaurant serving {{cuisine}} in {{city}}, with dine-in, takeaway and delivery. Languages: {{languages}}, Arabic pages right to left. Pages: home, menu (from our products in the category Menu), about, reservations (contact form), gallery, location and opening hours, FAQ. Tone: {{tone}}. Use the colours of our logo. Write an SEO title (under 60 characters) and a meta description (under 160) for every page, alt text for every picture, and keep everything unpublished until I say so."
msgstr "ابنِ موقعاً لشركتك، مطعم يقدم {{cuisine}} في {{city}}، مع الجلوس في المطعم والطلبات الخارجية والتوصيل. اللغات: {{languages}}، والصفحات العربية من اليمين إلى اليسار. الصفحات: الرئيسية، القائمة (من منتجاتنا في فئة القائمة)، من نحن، الحجز (نموذج تواصل)، معرض الصور، الموقع وساعات العمل، الأسئلة الشائعة. الأسلوب: {{tone}}. استخدم ألوان شعارنا. اكتب عنوان SEO (أقل من 60 حرفاً) ووصفاً تعريفياً (أقل من 160) لكل صفحة، ونصاً بديلاً لكل صورة، وأبقِ كل شيء غير منشور حتى أقول."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_web_contracting
msgid "Website: contracting company"
msgstr "موقع: شركة مقاولات"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_web_contracting
msgid "Opens the Website Builder interview pre-filled for contracting (template contracting); pages stay unpublished."
msgstr "يفتح مقابلة منشئ المواقع معبأة مسبقاً لهذا النشاط؛ تبقى الصفحات غير منشورة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_web_contracting
msgid "Build a website for your company, a contracting company doing {{works}} in {{city}} for {{clients}}. Languages: {{languages}}, Arabic pages right to left. Pages: home, services, projects (from our project names, only if I allow it), HSE and quality, certificates, careers, request a quotation, contact. Tone: {{tone}}. Use the colours of our logo. Write an SEO title (under 60 characters) and a meta description (under 160) for every page, alt text for every picture, and keep everything unpublished until I say so."
msgstr "ابنِ موقعاً لشركتك، شركة مقاولات تنفذ {{works}} في {{city}} لصالح {{clients}}. اللغات: {{languages}}، والصفحات العربية من اليمين إلى اليسار. الصفحات: الرئيسية، الخدمات، المشاريع (من أسماء مشاريعنا فقط إن سمحت)، الصحة والسلامة والجودة، الشهادات، الوظائف، طلب عرض سعر، اتصل بنا. الأسلوب: {{tone}}. استخدم ألوان شعارنا. اكتب عنوان SEO (أقل من 60 حرفاً) ووصفاً تعريفياً (أقل من 160) لكل صفحة، ونصاً بديلاً لكل صورة، وأبقِ كل شيء غير منشور حتى أقول."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_web_clinic
msgid "Website: clinic"
msgstr "موقع: عيادة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_web_clinic
msgid "Opens the Website Builder interview pre-filled for clinic (template clinic); pages stay unpublished."
msgstr "يفتح مقابلة منشئ المواقع معبأة مسبقاً لهذا النشاط؛ تبقى الصفحات غير منشورة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_web_clinic
msgid "Build a website for your company, a {{specialty}} clinic in {{city}} with {{doctors}} doctors. Languages: {{languages}}, Arabic pages right to left. Pages: home, specialties, doctors (public names and titles only), book an appointment, insurance accepted, patient instructions, FAQ, contact; no patient data anywhere. Tone: {{tone}}. Use the colours of our logo. Write an SEO title (under 60 characters) and a meta description (under 160) for every page, alt text for every picture, and keep everything unpublished until I say so."
msgstr "ابنِ موقعاً لشركتك، عيادة {{specialty}} في {{city}} فيها {{doctors}} أطباء. اللغات: {{languages}}، والصفحات العربية من اليمين إلى اليسار. الصفحات: الرئيسية، التخصصات، الأطباء (الأسماء والألقاب العامة فقط)، احجز موعداً، التأمين المقبول، تعليمات المرضى، الأسئلة الشائعة، اتصل بنا؛ دون أي بيانات للمرضى. الأسلوب: {{tone}}. استخدم ألوان شعارنا. اكتب عنوان SEO (أقل من 60 حرفاً) ووصفاً تعريفياً (أقل من 160) لكل صفحة، ونصاً بديلاً لكل صورة، وأبقِ كل شيء غير منشور حتى أقول."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_web_retail
msgid "Website + shop: retail store"
msgstr "موقع ومتجر: محل تجزئة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_web_retail
msgid "Opens the Website Builder interview pre-filled for retail (template fashion_shop); pages stay unpublished."
msgstr "يفتح مقابلة منشئ المواقع معبأة مسبقاً لهذا النشاط؛ تبقى الصفحات غير منشورة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_web_retail
msgid "Build a website for your company, a retail store selling {{goods}} with an online shop and pick-up in store. Languages: {{languages}}, Arabic pages right to left. Pages: home, shop (categories from our product categories), new arrivals, offers, about, store location, delivery and returns policy, contact. Add the online shop. Tone: {{tone}}. Use the colours of our logo. Write an SEO title (under 60 characters) and a meta description (under 160) for every page, alt text for every picture, and keep everything unpublished until I say so."
msgstr "ابنِ موقعاً لشركتك، محل تجزئة يبيع {{goods}} مع متجر إلكتروني واستلام من المحل. اللغات: {{languages}}، والصفحات العربية من اليمين إلى اليسار. الصفحات: الرئيسية، المتجر (الفئات من فئات منتجاتنا)، وصل حديثاً، العروض، من نحن، موقع المحل، سياسة التوصيل والإرجاع، اتصل بنا. أضف المتجر الإلكتروني. الأسلوب: {{tone}}. استخدم ألوان شعارنا. اكتب عنوان SEO (أقل من 60 حرفاً) ووصفاً تعريفياً (أقل من 160) لكل صفحة، ونصاً بديلاً لكل صورة، وأبقِ كل شيء غير منشور حتى أقول."

#. module: nudge
#: model:nudge.prompt,name:nudge.prompt_web_coffee_supplies
msgid "Website + shop: coffee supplies"
msgstr "موقع ومتجر: مستلزمات القهوة"

#. module: nudge
#: model:nudge.prompt,description:nudge.prompt_web_coffee_supplies
msgid "Opens the Website Builder interview pre-filled for coffee supplies (template food_products_shop); pages stay unpublished."
msgstr "يفتح مقابلة منشئ المواقع معبأة مسبقاً لهذا النشاط؛ تبقى الصفحات غير منشورة."

#. module: nudge
#: model:nudge.prompt,body:nudge.prompt_web_coffee_supplies
msgid "Build a website for your company, a coffee supplies trader selling {{goods}} to cafés and home baristas, wholesale and retail. Languages: {{languages}}, Arabic pages right to left. Pages: home, shop (beans, equipment, cups and packaging, syrups), wholesale enquiry form, brewing guides, about our roastery partners, delivery, contact. Add the online shop. Tone: {{tone}}. Use the colours of our logo. Write an SEO title (under 60 characters) and a meta description (under 160) for every page, alt text for every picture, and keep everything unpublished until I say so."
msgstr "ابنِ موقعاً لشركتك، تاجر مستلزمات قهوة يبيع {{goods}} للمقاهي ولمحبي القهوة في المنزل، جملة وتجزئة. اللغات: {{languages}}، والصفحات العربية من اليمين إلى اليسار. الصفحات: الرئيسية، المتجر (البن، المعدات، الأكواب والتغليف، النكهات)، نموذج طلب الجملة، أدلة التحضير، عن شركائنا في التحميص، التوصيل، اتصل بنا. أضف المتجر الإلكتروني. الأسلوب: {{tone}}. استخدم ألوان شعارنا. اكتب عنوان SEO (أقل من 60 حرفاً) ووصفاً تعريفياً (أقل من 160) لكل صفحة، ونصاً بديلاً لكل صورة، وأبقِ كل شيء غير منشور حتى أقول."

