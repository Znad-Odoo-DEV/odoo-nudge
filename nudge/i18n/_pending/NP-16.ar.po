# NP-16 Nudge Auditor: Arabic, to merge into ar.po
msgid "Nudge Auditor"
msgstr "مدقق Nudge"

msgid "Time-boxed, read-only: asks questions of the data and reads the log of what Nudge did."
msgstr "محدد بمدة وللقراءة فقط: يسأل عن البيانات ويقرأ سجل ما فعله Nudge."

msgid "Auditor Access Until"
msgstr "صلاحية المدقق حتى"

msgid "The last day an auditor can sign in. The day after, the access ends: the user is archived."
msgstr "آخر يوم يستطيع فيه المدقق تسجيل الدخول. في اليوم التالي تنتهي الصلاحية ويُؤرشف المستخدم."

msgid "Auditor Access Ended"
msgstr "انتهت صلاحية المدقق في"

msgid "Questions Asked"
msgstr "الأسئلة المطروحة"

msgid "%(user)s is a Nudge Auditor: the auditor is read-only and cannot also be an Agent User, a Nudge Manager or an administrator."
msgstr "%(user)s مدقق Nudge: المدقق للقراءة فقط ولا يمكن أن يكون أيضاً مستخدماً وكيلاً أو مدير Nudge أو مسؤول نظام."

msgid "Give the date an auditor can sign in until: the access of an auditor always has an end."
msgstr "حدد تاريخ آخر يوم يستطيع فيه المدقق الدخول: لصلاحية المدقق نهاية دائماً."

msgid "Only an administrator ends the access of an auditor."
msgstr "مسؤول النظام وحده ينهي صلاحية المدقق."

msgid "Add an Auditor"
msgstr "إضافة مدقق"

msgid "Add the Auditor"
msgstr "إضافة المدقق"

msgid "Only an administrator adds an auditor."
msgstr "مسؤول النظام وحده يضيف مدققاً."

msgid "The last day of the access cannot be in the past."
msgstr "آخر يوم للصلاحية لا يمكن أن يكون في الماضي."

msgid "%s acts, builds or manages: it cannot be given to an auditor."
msgstr "%s يتصرف أو يبني أو يدير: لا يمكن منحه لمدقق."

msgid "Login (e-mail)"
msgstr "تسجيل الدخول (البريد)"

msgid "Companies"
msgstr "الشركات"

msgid "The auditor sees the log and the data of these companies only."
msgstr "يرى المدقق سجل وبيانات هذه الشركات فقط."

msgid "Access Until"
msgstr "الصلاحية حتى"

msgid "The last day the auditor can sign in."
msgstr "آخر يوم يستطيع فيه المدقق الدخول."

msgid "Read-only Rights"
msgstr "صلاحيات القراءة فقط"

msgid "Send the Invitation"
msgstr "إرسال الدعوة"

msgid "Send the e-mail with the link to choose a password."
msgstr "إرسال رسالة بريد فيها رابط اختيار كلمة المرور."

msgid "Revoke the Access"
msgstr "إلغاء الصلاحية"

msgid "The auditor is archived now and cannot sign in again."
msgstr "يُؤرشف المدقق الآن ولا يستطيع الدخول مجدداً."

msgid "Questions of Auditors"
msgstr "أسئلة المدققين"

msgid "Asked on"
msgstr "تاريخ السؤال"

msgid "Question"
msgstr "السؤال"

msgid "No auditor has asked a question yet"
msgstr "لم يطرح أي مدقق سؤالاً بعد"

msgid "Every question an auditor asks is kept here for the company, even when old conversations are deleted."
msgstr "كل سؤال يطرحه المدقق يُحفظ هنا للشركة حتى عند حذف المحادثات القديمة."

msgid "Audit Log"
msgstr "سجل التدقيق"

msgid "Kept for Audit"
msgstr "محفوظ للتدقيق"

msgid "Asked by an auditor: kept for the company, never deleted by the retention of old conversations."
msgstr "سأله مدقق: محفوظ للشركة ولا تحذفه مدة الاحتفاظ بالمحادثات القديمة."

msgid "What an auditor asked is kept: this cannot be changed."
msgstr "ما سأله المدقق محفوظ: لا يمكن تغيير ذلك."

msgid "What an auditor asked is kept for the company and cannot be deleted."
msgstr "ما سأله المدقق محفوظ للشركة ولا يمكن حذفه."

msgid "Nudge: end the access of auditors"
msgstr "Nudge: إنهاء صلاحية المدققين"

msgid "%(group)s lets its users create, change or delete records (%(models)s): it cannot be given to an auditor, who only reads."
msgstr "تتيح المجموعة %(group)s لمستخدميها إنشاء السجلات أو تعديلها أو حذفها (%(models)s): لا يمكن منحها لمدقق يقرأ فقط."

msgid "What an auditor asked is kept: it cannot be archived or renamed."
msgstr "ما سأله المدقق محفوظ: لا يمكن أرشفته أو إعادة تسميته."
