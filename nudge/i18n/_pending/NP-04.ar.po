#. module: nudge
#. odoo-python
msgid "Nudge is answering other people right now. Your question waits for its turn."
msgstr "Nudge يجيب أشخاصًا آخرين الآن. سؤالك ينتظر دوره."

#. module: nudge
#. odoo-javascript
msgid "You are next in line (about %s s)."
msgstr "أنت التالي في الدور (حوالي %s ثانية)."

#. module: nudge
#. odoo-javascript
msgid "You are number %(position)s in line (about %(seconds)s s)."
msgstr "ترتيبك %(position)s في الدور (حوالي %(seconds)s ثانية)."

#. module: nudge
#. odoo-javascript
msgid "Nudge is still busy. Your question is kept: try it again in a moment."
msgstr "ما زال Nudge مشغولًا. سؤالك محفوظ: أعد إرساله بعد قليل."

#. module: nudge
#. odoo-javascript
msgid "Nudge is answering other people. Your question waits for its turn."
msgstr "Nudge يجيب أشخاصًا آخرين. سؤالك ينتظر دوره."

#. module: nudge
#. odoo-javascript
msgid "Try again"
msgstr "أعد المحاولة"

