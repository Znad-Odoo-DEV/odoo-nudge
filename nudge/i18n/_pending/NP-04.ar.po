#: model:ir.model.fields,field_description:nudge.field_nudge_slot__ended_at
msgid "Ended At"
msgstr "انتهى في"

#. module: nudge
#: model:ir.model.fields,field_description:nudge.field_nudge_conversation__stream_serial
