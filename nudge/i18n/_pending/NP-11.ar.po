# NP-11 and NP-12 pending translations, to be merged into ar.po by the lead
msgid ""
msgstr ""
"Language: ar\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Activities due today: %s"
msgstr "أنشطة مستحقة اليوم: %s"

msgid "Activities overdue: %s"
msgstr "أنشطة متأخرة: %s"

msgid "Approvals waiting for you: %s"
msgstr "موافقات بانتظارك: %s"

msgid "Waiting for you today:"
msgstr "ما ينتظرك اليوم:"

msgid "Nothing is waiting for you today."
msgstr "لا شيء ينتظرك اليوم."

msgid "What is its name?"
msgstr "ما اسمه؟"

msgid "What is its title?"
msgstr "ما عنوانه؟"

msgid "For which dates?"
msgstr "لأي تواريخ؟"

msgid "For which contact?"
msgstr "لأي جهة اتصال؟"

msgid "Which products, and how many?"
msgstr "أي منتجات، وكم الكمية؟"

msgid "Which one do you mean? Write its name."
msgstr "أي واحد تقصد؟ اكتب اسمه."

msgid "Did you mean: %s?"
msgstr "هل تقصد: %s؟"

msgid " or "
msgstr " أو "

msgid "Only Nudge managers improve the words Nudge understands."
msgstr "مديرو Nudge فقط يحسّنون الكلمات التي يفهمها Nudge."

msgid "Write the word and choose what it means."
msgstr "اكتب الكلمة واختر معناها."

msgid "Not yet: it needs more words"
msgstr "ليس بعد: يحتاج إلى كلمات أكثر"

msgid "Word added"
msgstr "أُضيفت الكلمة"

msgid "“%(sentence)s” now means: %(result)s"
msgstr "«%(sentence)s» تعني الآن: %(result)s"

msgid "Sentences the Rules Missed"
msgstr "جمل لم تفهمها القواعد"

msgid "Sentence"
msgstr "الجملة"

msgid "Last 7 Days"
msgstr "آخر ٧ أيام"

msgid "Word or Phrase"
msgstr "كلمة أو عبارة"

msgid "The word the rules did not know. Nudge will understand it like the words it knows."
msgstr "الكلمة التي لم تعرفها القواعد. سيفهمها Nudge مثل الكلمات التي يعرفها."

msgid "Means"
msgstr "تعني"

msgid "Missed"
msgstr "لم تُفهم"

msgid "Word Added"
msgstr "أُضيفت الكلمة"

msgid "Now Understood As"
msgstr "تُفهم الآن على أنها"

msgid "Missed Sentences"
msgstr "الجمل الفائتة"

msgid "Make entry"
msgstr "أضف كلمة"

msgid "Save as an answer"
msgstr "احفظ كإجابة"

msgid "The rules understood everything asked this week"
msgstr "فهمت القواعد كل ما سُئل هذا الأسبوع"

msgid "Here are the sentences asked in the last seven days that Nudge could not answer without an AI, the most asked first. Write the word it did not know and what it means, then press Make entry: the next time, Nudge understands it without any AI. Or save an answer for the sentence."
msgstr "هذه الجمل التي سُئلت في آخر سبعة أيام ولم يستطع Nudge الإجابة عنها دون ذكاء اصطناعي، الأكثر تكراراً أولاً. اكتب الكلمة التي لم يعرفها ومعناها ثم اضغط «أضف كلمة»: في المرة القادمة يفهمها Nudge دون أي ذكاء اصطناعي. أو احفظ إجابة للجملة."
