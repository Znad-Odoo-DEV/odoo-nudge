#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/setup.py:0
msgid " (not yet: %s)"
msgstr " (غير متاح بعد: %s)"

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/setup.py:0
msgid " The usual one here is %s: say “default” to take it."
msgstr " المعتاد هنا هو %s: قل «افتراضي» لأعتمده."

#. module: nudge
#. odoo-python
#: code:addons/nudge/models/nudge_skill.py:0
msgid " and its tool %s"
msgstr " وأداتها %s"

#. module: nudge
#. odoo-python
#: code:addons/nudge/models/nudge_noai.py:0
#: code:addons/nudge/tools/analytics.py:0
msgid " or "
msgstr "أو"

#. module: nudge
#: model_terms:ir.ui.view,arch_db:nudge.nudge_skill_view_form
msgid ""
"## Invoice follow-up\n"
"- Read the overdue invoices of the customer first..."
msgstr ""
"## Invoice follow-up\n"
"- Read the overdue invoices of the customer first..."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s %(model)s have a %(field)s that belongs to another company."
msgstr "%(count)s من %(model)s لها %(field)s يتبع شركة أخرى."

#. module: nudge
#. odoo-python
#: code:addons/nudge/models/nudge_noai.py:0
msgid "%(count)s %(what)s%(said)s."
msgstr "%(count)s %(what)s%(said)s."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid "%(count)s %(where)s refer to %(what)s. Fix: %(note)s."
msgstr "%(count)s من %(where)s تشير إلى %(what)s. الحل: %(note)s."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s %(where)s still say tree. Fix: write list (<list> in views, list "
"in the view mode)."
msgstr ""
"%(count)s من %(where)s ما زالت تكتب tree. الحل: اكتب list (الوسم <list> في "
"الواجهات وlist في أنماط العرض)."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s automation rules. Their code and filters are logic that no screen "
"shows. Fix: read each one on a staging copy and fire it once."
msgstr ""
"%(count)s قاعدة أتمتة. كودها وفلاترها منطق لا تظهره أي شاشة. الحل: اقرأ كل "
"واحدة على نسخة تجريبية وشغّلها مرة."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s barcodes are used by more than one product."
msgstr "%(count)s من الباركودات مستخدمة في أكثر من منتج."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s companies miss a default account of their accounting."
msgstr "%(count)s من الشركات ينقصها حساب افتراضي في محاسبتها."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid ""
"%(count)s contacts, among %(sample)s looked at, have a fiscal position that "
"applies to another country than theirs."
msgstr ""
"%(count)s من جهات الاتصال، من بين %(sample)s تم فحصها، لها موقف مالي يخص "
"بلدًا غير بلدها."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s custom fields (x_) on standard models. Fix: check each one still "
"has a place on the new series' form; the upgrade keeps the column and drops "
"a view that cannot find its field."
msgstr ""
"%(count)s حقل مخصّص (x_) على نماذج قياسية. الحل: تأكد أن لكل واحد مكاناً في "
"شاشة الإصدار الجديد؛ الترقية تحفظ العمود وتُسقط الواجهة التي لا تجد حقلها."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s custom fields computed by code. Hidden logic: it is not in a view "
"or an action. Fix: read the code for removed fields and methods, and check "
"the totals after the upgrade."
msgstr ""
"%(count)s حقل مخصّص يُحسب بكود. منطق مخفي: لا يظهر في واجهة ولا في إجراء. "
"الحل: اقرأ الكود بحثاً عن حقول ودوال ملغاة، وتحقّق من المجاميع بعد الترقية."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s custom fields that follow a related path. A renamed field on the "
"way breaks them silently. Fix: compare the values before and after on a "
"staging copy."
msgstr ""
"%(count)s حقل مخصّص يتبع مساراً مرتبطاً. حقل تغيّر اسمه في الطريق يكسره "
"بصمت. الحل: قارن القيم قبل وبعد على نسخة تجريبية."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s custom views still use attrs= or states= in their markup, which "
"the new series refuses. Fix: write the conditions as invisible=, readonly= "
"or required= with a Python expression."
msgstr ""
"%(count)s واجهة مخصّصة ما زالت تستعمل attrs= أو states= ويرفضها الإصدار "
"الجديد. الحل: اكتب الشروط على شكل invisible= أو readonly= أو required= "
"بتعبير Python."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s custom window actions already fail to open a screen (a sample of "
"%(sample)s was opened). Fix: repair or delete them first: the upgrade will "
"not do it, and they would be blamed on it."
msgstr ""
"%(count)s إجراء نافذة مخصّص يفشل أصلاً في فتح شاشة (فُتحت عيّنة من "
"%(sample)s). الحل: أصلحها أو احذفها أولاً: الترقية لن تفعل ذلك، وسيُنسب "
"فشلها إليها."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s customer invoice lines have a unit price far from the usual for "
"the same product."
msgstr ""
"%(count)s من بنود فواتير العملاء سعر وحدتها بعيد عن المعتاد للمنتج نفسه."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid "%(count)s customer invoices are far from the usual for this customer."
msgstr "%(count)s من فواتير العملاء بعيدة عن المعتاد لهذا العميل."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s days of attendance are far from the hours the same person usually "
"works."
msgstr "%(count)s من أيام الحضور بعيدة عن ساعات العمل المعتادة للشخص نفسه."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s days show overtime far above what the same person usually works."
msgstr ""
"%(count)s من الأيام فيها وقت إضافي أعلى بكثير مما يعمله الشخص نفسه عادةً."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s email addresses are used by more than one contact."
msgstr "%(count)s من عناوين البريد مستخدمة لأكثر من جهة اتصال."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s emails could not be sent."
msgstr "%(count)s من الرسائل الإلكترونية لم يمكن إرسالها."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid ""
"%(count)s emails have waited more than %(hours)s hours in the outgoing "
"queue."
msgstr ""
"%(count)s من الرسائل الإلكترونية تنتظر منذ أكثر من %(hours)s ساعة في طابور "
"الإرسال."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid "%(count)s expenses are far above the usual for their category."
msgstr "%(count)s من المصروفات أعلى بكثير من المعتاد لفئتها."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s external ids belong to a module that is not in the database. Fix: "
"remove the leftovers (technical menu Settings / Technical / External "
"Identifiers)."
msgstr ""
"%(count)s معرّف خارجي يخص وحدة غير موجودة في قاعدة البيانات. الحل: احذف "
"البقايا (القائمة التقنية: الإعدادات / تقني / المعرّفات الخارجية)."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s external ids name a record that was deleted. Fix: remove them."
msgstr "%(count)s معرّف خارجي يسمّي سجلاً محذوفاً. الحل: احذفها."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s fields link to a model that no longer exists. Fix: remove the "
"field or restore the model."
msgstr ""
"%(count)s حقل يرتبط بنموذج لم يعد موجوداً. الحل: احذف الحقل أو أعد النموذج."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid ""
"%(count)s files, among the last %(sample)s, belong to a record that no "
"longer exists."
msgstr ""
"%(count)s من الملفات، من بين آخر %(sample)s، تتبع سجلًا لم يعد موجودًا."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/scaffold.py:0
msgid ""
"%(count)s files, checked: they compile, parse and agree with each other"
msgstr "%(count)s ملفًا جرى فحصها: تُترجَم برمجيًا وتُقرأ وتتّفق مع بعضها"

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s goods receipts have a zero or negative cost, so stock is valued "
"wrongly."
msgstr ""
"%(count)s من استلامات البضائع بتكلفة صفرية أو سالبة، فيُقيَّم المخزون خطأً."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s internal references are used by more than one product."
msgstr "%(count)s من المراجع الداخلية مستخدمة في أكثر من منتج."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s internal users have no access group beyond the basic one."
msgstr ""
"%(count)s من المستخدمين الداخليين ليس لهم مجموعة صلاحيات غير الأساسية."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s journals have no default account."
msgstr "%(count)s من اليوميات ليس لها حساب افتراضي."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/validator.py:0
msgid ""
"%(count)s lines have a quantity far above the usual for the product: "
"%(names)s (usual: %(usual)s)."
msgstr ""
"%(count)s من البنود كميتها أعلى بكثير من المعتاد للمنتج: %(names)s (المعتاد:"
" %(usual)s)."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/validator.py:0
msgid ""
"%(count)s lines pay far more than the last purchases of the same product: "
"%(names)s."
msgstr ""
"%(count)s من البنود تدفع أكثر بكثير من آخر مشتريات المنتج نفسه: %(names)s."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/validator.py:0
msgid "%(count)s lines sell under the cost of the product: %(names)s."
msgstr "%(count)s من البنود تبيع بأقل من تكلفة المنتج: %(names)s."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s locations hold a negative quantity of something."
msgstr "%(count)s من المواقع فيها كمية سالبة من شيء ما."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s models made by hand (x_). Each one is yours to carry: nothing "
"upgrades it for you but a copy of the database, so open its screens on a "
"staging copy."
msgstr ""
"%(count)s نموذج صُنع يدوياً (x_). كل واحد عليك أنت حمله: لا شيء يرقّيه عنك "
"إلا نسخة من قاعدة البيانات، فافتح شاشاته على نسخة تجريبية."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s modules that are not Odoo's are installed. Each one must be ported"
" to the new series by its author; the upgrade does not touch them."
msgstr ""
"%(count)s وحدة مثبّتة ليست من Odoo. كل واحدة يجب أن يرقّيها صاحبها إلى "
"الإصدار الجديد؛ الترقية لا تلمسها."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/bulk.py:0
msgid ""
"%(count)s more will be written without review. To see every answer first, "
"narrow to %(max)s records or fewer (Review all)."
msgstr ""
"سيُكتب %(count)s آخر دون مراجعة. لترى كل إجابة أولًا، ضيّق النطاق إلى "
"%(max)s سجلًا أو أقل (Review all)."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid ""
"%(count)s names are written twice or more for contacts, apart from capitals,"
" spaces and signs."
msgstr ""
"%(count)s من الأسماء مكتوبة مرتين أو أكثر لجهات الاتصال، بغض النظر عن الأحرف"
" الكبيرة والمسافات والرموز."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s of %(where)s call a method the new series no longer has. Fix: "
"%(hint)s."
msgstr ""
"%(count)s من %(where)s تستدعي دالة لم تعد موجودة في الإصدار الجديد. الحل: "
"%(hint)s."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s of %(where)s link to /web#, the old address of the backend. Fix: "
"use /odoo/... (for example /odoo/action-<id>/<record id>)."
msgstr ""
"%(count)s من %(where)s تربط إلى /web# وهو العنوان القديم للواجهة الخلفية. "
"الحل: استعمل /odoo/... (مثلاً /odoo/action-<رقم>/<رقم السجل>)."

#. module: nudge
#. odoo-python
#: code:addons/nudge/models/nudge_compliance_feed.py:0
msgid "%(count)s pack(s) wait for approval: %(packs)s."
msgstr "%(count)s حزمة بانتظار الموافقة: %(packs)s."

#. module: nudge
#. odoo-python
#: code:addons/nudge/models/nudge_doc.py:0
msgid "%(count)s pages of the official documentation of Odoo %(version)s."
msgstr "%(count)s صفحة من توثيق Odoo %(version)s الرسمي."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s payslips have a gross pay far from what the same employee usually "
"gets."
msgstr ""
"%(count)s من قسائم الراتب إجمالي الراتب فيها بعيد عما يتقاضاه الموظف نفسه "
"عادةً."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s payslips have a net pay far from what the same employee usually "
"gets."
msgstr ""
"%(count)s من قسائم الراتب صافي الراتب فيها بعيد عما يتقاضاه الموظف نفسه "
"عادةً."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s payslips pay an employee far from the others of the same job or "
"department that month."
msgstr ""
"%(count)s من قسائم الراتب تدفع لموظف مبلغاً بعيداً عن زملائه في الوظيفة أو "
"القسم نفسه في ذلك الشهر."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid ""
"%(count)s phone numbers are used by more than one contact, whatever the "
"spaces and the prefix."
msgstr ""
"%(count)s من أرقام الهاتف مستخدمة لأكثر من جهة اتصال، مهما كانت المسافات "
"والمقدمة."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s product names are used twice or more in the same category."
msgstr "%(count)s من أسماء المنتجات مكررة في نفس الفئة."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s products can be purchased but have no cost."
msgstr "%(count)s من المنتجات يمكن شراؤها وليس لها تكلفة."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s products can be sold but carry no sales tax."
msgstr "%(count)s من المنتجات يمكن بيعها وليس عليها ضريبة مبيعات."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s products can be sold but have no sale price."
msgstr "%(count)s من المنتجات يمكن بيعها وليس لها سعر بيع."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s products have no category."
msgstr "%(count)s من المنتجات بلا فئة."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s purchase lines pay far more than the last purchases of the same "
"product."
msgstr "%(count)s من بنود الشراء بسعر أعلى بكثير من آخر مشتريات المنتج نفسه."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s purchase orders are billed for more than they were ordered for."
msgstr "%(count)s من أوامر الشراء فُوتِرت بأكثر مما طُلب فيها."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s records carry several external ids of Studio or imports. Fix: keep"
" the one a module needs and remove the others."
msgstr ""
"%(count)s سجل يحمل عدة معرّفات خارجية من ستوديو أو الاستيراد. الحل: أبقِ "
"الذي تحتاجه وحدة واحدة واحذف الباقي."

#. module: nudge
#. odoo-python
#: code:addons/nudge/models/nudge_recipe_market.py:0
msgid "%(count)s refused: %(list)s"
msgstr "%(count)s مرفوضة: %(list)s"

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s reports made with Studio. Fix: print one of each on a staging "
"copy."
msgstr ""
"%(count)s تقرير صنعه ستوديو. الحل: اطبع واحداً من كل نوع على نسخة تجريبية."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/report_explain.py:0
msgid "%(count)s rows (%(names)s) make %(share)s of the total."
msgstr "%(count)s صفوف (%(names)s) تمثل %(share)s من الإجمالي."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/report_explain.py:0
msgid "%(count)s rows are below zero, for instance %(names)s."
msgstr "%(count)s صفوف أقل من الصفر، مثل %(names)s."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s sales order lines give a discount far above the usual for the same"
" customer."
msgstr ""
"%(count)s من بنود أوامر البيع تمنح خصماً أعلى بكثير من المعتاد للعميل نفسه."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid ""
"%(count)s sales order lines give a discount far above the usual for the same"
" product."
msgstr ""
"%(count)s من بنود أوامر البيع تمنح خصماً أعلى بكثير من المعتاد للمنتج نفسه."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/outliers.py:0
msgid "%(count)s sales order lines sell under the cost of the product."
msgstr "%(count)s من بنود أوامر البيع تبيع بأقل من تكلفة المنتج."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/health.py:0
msgid "%(count)s scheduled actions failed their last runs."
msgstr "%(count)s من الإجراءات المجدولة فشلت في آخر تشغيل لها."

#. module: nudge
#. odoo-python
#: code:addons/nudge/tools/upgrade.py:0
msgid ""
"%(count)s server actions made by hand, each a piece of Python or a set of "
