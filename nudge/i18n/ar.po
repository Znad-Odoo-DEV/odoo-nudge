msgstr "حفظ كمرجع"

#. module: nudge
#. odoo-javascript
#: code:addons/nudge/static/src/memory/reference.xml:0
msgid "Save as reference"
msgstr "حفظ كمرجع"

#. module: nudge
#. odoo-python
#: code:addons/nudge/models/nudge_memory.py:0
msgid ""
"Saved: the same question is answered from Nudge's memory from now on, with "
"no AI."
msgstr "تم الحفظ: يُجاب السؤال نفسه من ذاكرة Nudge من الآن، دون ذكاء اصطناعي."

#. module: nudge
#: model:ir.model.fields,help:nudge.field_nudge_memory__screen_bound
msgid ""
"Served only to someone asking from that screen: for an answer that says "
"“this button”."
msgstr "تُقدَّم فقط لمن يسأل من تلك الشاشة: لإجابة تقول «هذا الزر»."

#. module: nudge
#. odoo-python
#: code:addons/nudge/models/nudge_tour.py:0
msgid "Steps of a remembered answer"
msgstr "خطوات إجابة محفوظة"

#. module: nudge
#: model:ir.model.fields,field_description:nudge.field_nudge_memory__tour_id
#: model:ir.model.fields,field_description:nudge.field_nudge_memory_save__step_lines
msgid "Steps on the Screen"
msgstr "الخطوات على الشاشة"

#. module: nudge
#: model:ir.model.fields,field_description:nudge.field_res_config_settings__nudge_memory_like_suggest
msgid "Suggest From Likes"
msgstr "الاقتراح من الإعجابات"

#. module: nudge
