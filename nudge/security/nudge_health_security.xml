<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="nudge_health_report_rule_company" model="ir.rule">
            <field name="name">Nudge Health Report: companies of the user</field>
            <field name="model_id" ref="model_nudge_health_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_health_finding_rule_company" model="ir.rule">
            <field name="name">Nudge Health Finding: companies of the user</field>
            <field name="model_id" ref="model_nudge_health_finding"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_validator_policy_rule_company" model="ir.rule">
            <field name="name">Nudge Entry Policy: companies of the user</field>
            <field name="model_id" ref="model_nudge_validator_policy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
