<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- A note belongs to a company, or to all of them: a manager reads and writes the notes of the
             companies they work in. Which people a note is told to (its groups) is decided where the
             prompt is built, as the people themselves have no access to the table -->
        <record id="nudge_note_rule_company" model="ir.rule">
            <field name="name">Nudge Business Note: my companies</field>
            <field name="model_id" ref="model_nudge_note"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>
    </data>
</odoo>
