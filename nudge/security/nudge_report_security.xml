<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- A saved report is its owner's, in the companies they work in -->
        <record id="nudge_report_rule_own" model="ir.rule">
            <field name="name">Nudge Report: own, in my companies</field>
            <field name="model_id" ref="model_nudge_report"/>
            <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
        </record>

        <!-- A manager reads the reports of the people of their companies -->
        <record id="nudge_report_rule_manager" model="ir.rule">
            <field name="name">Nudge Report: manager, in my companies</field>
            <field name="model_id" ref="model_nudge_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>
    </data>
</odoo>
