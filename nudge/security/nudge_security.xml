<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nudge" model="ir.module.category">
        <field name="name">Nudge</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_nudge" model="res.groups.privilege">
        <field name="name">Nudge</field>
        <field name="category_id" ref="module_category_nudge"/>
    </record>

    <record id="group_nudge_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_nudge"/>
        <field name="comment">Can chat with Nudge and follow its guidance.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_nudge_agent" model="res.groups">
        <field name="name">Agent User</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_nudge"/>
        <field name="comment">Can also let Nudge perform actions on their behalf.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_nudge_user'))]"/>
    </record>

    <record id="group_nudge_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_nudge"/>
        <field name="comment">Manages Nudge settings and sees every conversation.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_nudge_agent'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="nudge_conversation_rule_own" model="ir.rule">
            <field name="name">Nudge Conversation: own</field>
            <field name="model_id" ref="model_nudge_conversation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
        </record>

        <record id="nudge_conversation_rule_manager" model="ir.rule">
            <field name="name">Nudge Conversation: all</field>
            <field name="model_id" ref="model_nudge_conversation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_message_rule_own" model="ir.rule">
            <field name="name">Nudge Message: own</field>
            <field name="model_id" ref="model_nudge_message"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
        </record>

        <record id="nudge_message_rule_manager" model="ir.rule">
            <field name="name">Nudge Message: all</field>
            <field name="model_id" ref="model_nudge_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_source_rule_groups" model="ir.rule">
            <field name="name">Nudge Company File: for its groups</field>
            <field name="model_id" ref="model_nudge_source"/>
            <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.all_group_ids.ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
        </record>

        <record id="nudge_source_rule_manager" model="ir.rule">
            <field name="name">Nudge Company File: all for managers</field>
            <field name="model_id" ref="model_nudge_source"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_source_passage_rule_groups" model="ir.rule">
            <field name="name">Nudge Company File Passage: for its groups</field>
            <field name="model_id" ref="model_nudge_source_passage"/>
            <field name="domain_force">['|', ('source_id.group_ids', '=', False), ('source_id.group_ids', 'in', user.all_group_ids.ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
        </record>

        <record id="nudge_source_passage_rule_manager" model="ir.rule">
            <field name="name">Nudge Company File Passage: all for managers</field>
            <field name="model_id" ref="model_nudge_source_passage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_digest_link_rule_own" model="ir.rule">
            <field name="name">Nudge Digest Link: own</field>
            <field name="model_id" ref="model_nudge_digest_link"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
        </record>

        <record id="nudge_task_rule_own" model="ir.rule">
            <field name="name">Nudge Scheduled Task: own</field>
            <field name="model_id" ref="model_nudge_task"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_agent'))]"/>
        </record>

        <record id="nudge_task_rule_manager" model="ir.rule">
            <field name="name">Nudge Scheduled Task: all, to read</field>
            <field name="model_id" ref="model_nudge_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="nudge_run_rule_own" model="ir.rule">
            <field name="name">Nudge Run: own</field>
            <field name="model_id" ref="model_nudge_run"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_agent'))]"/>
        </record>

        <record id="nudge_run_rule_manager" model="ir.rule">
            <field name="name">Nudge Run: all</field>
            <field name="model_id" ref="model_nudge_run"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_step_rule_own" model="ir.rule">
            <field name="name">Nudge Step: own</field>
            <field name="model_id" ref="model_nudge_step"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_agent'))]"/>
        </record>

        <record id="nudge_step_rule_manager" model="ir.rule">
            <field name="name">Nudge Step: all</field>
            <field name="model_id" ref="model_nudge_step"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_history_rule_own" model="ir.rule">
            <field name="name">Nudge Record Summary: own</field>
            <field name="model_id" ref="model_nudge_history"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
        </record>

        <record id="nudge_history_rule_manager" model="ir.rule">
            <field name="name">Nudge Record Summary: all for managers</field>
            <field name="model_id" ref="model_nudge_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_built_rule_company" model="ir.rule">
            <field name="name">Nudge Made by Nudge: companies of the user</field>
            <field name="model_id" ref="model_nudge_built"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="nudge_memory_rule_company" model="ir.rule">
            <field name="name">Nudge Answer Memory: companies of the manager</field>
            <field name="model_id" ref="model_nudge_memory"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_question_rule_company" model="ir.rule">
            <field name="name">Nudge Recurring Question: companies of the manager</field>
            <field name="model_id" ref="model_nudge_question"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_lexicon_entry_rule_company" model="ir.rule">
            <field name="name">Nudge Lexicon Entry: companies of the user</field>
            <field name="model_id" ref="model_nudge_lexicon_entry"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="nudge_recipe_installed_rule_company" model="ir.rule">
            <field name="name">Nudge Installed Recipe: companies of the user</field>
            <field name="model_id" ref="model_nudge_recipe_installed"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="nudge_health_report_rule_company" model="ir.rule">
            <field name="name">Nudge Health Report: companies of the manager</field>
            <field name="model_id" ref="model_nudge_health_report"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_health_finding_rule_company" model="ir.rule">
            <field name="name">Nudge Health Finding: companies of the manager</field>
            <field name="model_id" ref="model_nudge_health_finding"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_usage_rule_company" model="ir.rule">
            <field name="name">Nudge Usage: companies of the manager</field>
            <field name="model_id" ref="model_nudge_usage"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>
        <record id="nudge_coach_rule_own" model="ir.rule">
            <field name="name">Nudge Coaching: own</field>
            <field name="model_id" ref="model_nudge_coach"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
        </record>

        <record id="nudge_coach_rule_manager" model="ir.rule">
            <field name="name">Nudge Coaching: all for managers</field>
            <field name="model_id" ref="model_nudge_coach"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>
    </data>
</odoo>
