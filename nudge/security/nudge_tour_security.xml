<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="nudge_tour_rule_user" model="ir.rule">
            <field name="name">Nudge Tour: for its groups and companies</field>
            <field name="model_id" ref="model_nudge_tour"/>
            <field name="domain_force">['&amp;', '|', ('group_ids', '=', False), ('group_ids', 'in', user.groups_id.ids), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
        </record>

        <record id="nudge_tour_rule_manager" model="ir.rule">
            <field name="name">Nudge Tour: all for managers</field>
            <field name="model_id" ref="model_nudge_tour"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>

        <record id="nudge_tour_step_rule_user" model="ir.rule">
            <field name="name">Nudge Tour Step: for the groups and companies of its tour</field>
            <field name="model_id" ref="model_nudge_tour_step"/>
            <field name="domain_force">['&amp;', '|', ('tour_id.group_ids', '=', False), ('tour_id.group_ids', 'in', user.groups_id.ids), '|', ('tour_id.company_id', '=', False), ('tour_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
        </record>

        <record id="nudge_tour_step_rule_manager" model="ir.rule">
            <field name="name">Nudge Tour Step: all for managers</field>
            <field name="model_id" ref="model_nudge_tour_step"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>
    </data>
</odoo>
