<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Reading: your own private prompts, and the shared ones of your companies and your groups -->
        <record id="nudge_prompt_rule_read" model="ir.rule">
            <field name="name">Nudge Prompt: own and shared</field>
            <field name="model_id" ref="model_nudge_prompt"/>
            <field name="domain_force">['|',
                '&amp;', ('scope', '=', 'private'), ('user_id', '=', user.id),
                '&amp;', '&amp;', ('scope', '!=', 'private'),
                    '|', ('company_id', '=', False), ('company_id', 'in', company_ids),
                    '|', ('group_ids', '=', False), ('group_ids', 'in', user.all_group_ids.ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Writing: a person writes their own private prompts -->
        <record id="nudge_prompt_rule_write_own" model="ir.rule">
            <field name="name">Nudge Prompt: write own private</field>
            <field name="model_id" ref="model_nudge_prompt"/>
            <field name="domain_force">[('scope', '=', 'private'), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_user'))]"/>
            <field name="perm_read" eval="False"/>
        </record>

        <!-- A manager also sees and writes what is shared with their companies (never the private prompts of others) -->
        <record id="nudge_prompt_rule_manager" model="ir.rule">
            <field name="name">Nudge Prompt: shared, for managers</field>
            <field name="model_id" ref="model_nudge_prompt"/>
            <field name="domain_force">['|',
                '&amp;', ('scope', '=', 'private'), ('user_id', '=', user.id),
                '&amp;', ('scope', '!=', 'private'),
                    '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>
    </data>
</odoo>
