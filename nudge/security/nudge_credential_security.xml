<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- NP-17: a manager reads and writes the credentials of the companies they work in -->
        <record id="nudge_credential_rule_company" model="ir.rule">
            <field name="name">Nudge Credential Expiry: my companies</field>
            <field name="model_id" ref="model_nudge_credential"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_nudge_manager'))]"/>
        </record>
    </data>
</odoo>
