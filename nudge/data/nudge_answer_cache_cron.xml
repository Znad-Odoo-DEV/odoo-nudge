<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- S7: the answers older than the time they are kept for are forgotten -->
    <record id="cron_answer_cache_purge" model="ir.cron">
        <field name="name">Nudge: forget old cached answers</field>
        <field name="model_id" ref="model_nudge_answer_cache"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
