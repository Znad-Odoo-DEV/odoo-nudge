<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- S9: the requests that come back to the AI are read once a night, from the log, with no provider -->
    <record id="cron_observe_rules" model="ir.cron">
        <field name="name">Nudge: find the requests that come back</field>
        <field name="model_id" ref="model_nudge_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_observe()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
