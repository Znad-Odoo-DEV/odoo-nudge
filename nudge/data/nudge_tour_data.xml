<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Ready-made tours for the apps of Odoo Community. Each is only offered where its app is installed. -->
    <record id="tour_create_quotation" model="nudge.tour">
        <field name="name">Create a quotation</field>
        <field name="phrases_en">create a quotation
new quotation
new quote
make a quote</field>
        <field name="phrases_ar">انشاء عرض سعر
عرض سعر جديد
كيف اعمل عرض سعر</field>
        <field name="action_xmlid">sale.action_quotations_with_onboarding</field>
        <field name="module_name">sale</field>
        <field name="is_library" eval="True"/>
    </record>
    <record id="tour_create_quotation_1" model="nudge.tour.step">
        <field name="tour_id" ref="tour_create_quotation"/>
        <field name="sequence">10</field>
        <field name="kind">control</field>
        <field name="name">new</field>
        <field name="label">New</field>
        <field name="note">Press New to start a quotation.</field>
        <field name="res_model">sale.order</field>
        <field name="view_type">list</field>
    </record>
    <record id="tour_create_quotation_2" model="nudge.tour.step">
        <field name="tour_id" ref="tour_create_quotation"/>
        <field name="sequence">20</field>
        <field name="kind">field</field>
        <field name="name">partner_id</field>
        <field name="label">Customer</field>
        <field name="note">Choose the customer the quotation is for.</field>
        <field name="res_model">sale.order</field>
        <field name="view_type">form</field>
    </record>
    <record id="tour_create_quotation_3" model="nudge.tour.step">
        <field name="tour_id" ref="tour_create_quotation"/>
        <field name="sequence">30</field>
        <field name="kind">field</field>
        <field name="name">order_line</field>
        <field name="label">Order Lines</field>
        <field name="note">Add the products: press Add a product, choose it and set the quantity.</field>
        <field name="res_model">sale.order</field>
        <field name="view_type">form</field>
    </record>
    <record id="tour_create_quotation_4" model="nudge.tour.step">
        <field name="tour_id" ref="tour_create_quotation"/>
        <field name="sequence">40</field>
        <field name="kind">control</field>
        <field name="name">save</field>
        <field name="label">Save</field>
        <field name="note">Save the quotation.</field>
        <field name="res_model">sale.order</field>
        <field name="view_type">form</field>
    </record>
    <record id="tour_confirm_sales_order" model="nudge.tour">
        <field name="name">Confirm a sales order</field>
        <field name="phrases_en">confirm a sales order
confirm a quotation
confirm an order
confirm sale</field>
        <field name="phrases_ar">تأكيد أمر بيع
تأكيد عرض السعر
كيف اأكد طلب بيع</field>
        <field name="action_xmlid">sale.action_quotations_with_onboarding</field>
        <field name="module_name">sale</field>
        <field name="is_library" eval="True"/>
    </record>
    <record id="tour_confirm_sales_order_1" model="nudge.tour.step">
        <field name="tour_id" ref="tour_confirm_sales_order"/>
        <field name="sequence">10</field>
        <field name="kind">control</field>
        <field name="name">search</field>
        <field name="label">Search</field>
        <field name="note">Find the quotation by its number or the name of the customer.</field>
        <field name="res_model">sale.order</field>
        <field name="view_type">list</field>
    </record>
    <record id="tour_confirm_sales_order_2" model="nudge.tour.step">
        <field name="tour_id" ref="tour_confirm_sales_order"/>
        <field name="sequence">20</field>
        <field name="kind">button</field>
        <field name="name">action_confirm</field>
        <field name="label">Confirm</field>
        <field name="note">Open the quotation and press Confirm: it becomes a sales order.</field>
        <field name="res_model">sale.order</field>
        <field name="view_type">form</field>
    </record>
