    <record id="tour_create_contact_4" model="nudge.tour.step">
        <field name="tour_id" ref="tour_create_contact"/>
        <field name="sequence">40</field>
        <field name="kind">field</field>
        <field name="name">email</field>
        <field name="label">Email</field>
        <field name="note">Add the email address: quotations and invoices are sent to it.</field>
        <field name="res_model">res.partner</field>
        <field name="view_type">form</field>
    </record>
    <record id="tour_create_contact_5" model="nudge.tour.step">
        <field name="tour_id" ref="tour_create_contact"/>
        <field name="sequence">50</field>
        <field name="kind">control</field>
        <field name="name">save</field>
        <field name="label">Save</field>
        <field name="note">Save the contact.</field>
        <field name="res_model">res.partner</field>
        <field name="view_type">form</field>
    </record>
    <record id="tour_create_product" model="nudge.tour">
