        <field name="tour_id" ref="tour_create_product"/>
        <field name="sequence">50</field>
        <field name="kind">control</field>
        <field name="name">save</field>
        <field name="label">Save</field>
        <field name="note">Save the product.</field>
        <field name="res_model">product.template</field>
        <field name="view_type">form</field>
    </record>
    <record id="tour_receive_purchase_order" model="nudge.tour">
        <field name="name">Receive a purchase order</field>
        <field name="phrases_en">receive a purchase order
receive goods
receive a purchase
receipt of a purchase order</field>
        <field name="phrases_ar">استلام أمر شراء
استلام بضاعة
استلام المشتريات</field>
        <field name="action_xmlid">purchase.purchase_form_action</field>
        <field name="module_name">purchase_stock</field>
        <field name="is_library" eval="True"/>
    </record>
    <record id="tour_receive_purchase_order_1" model="nudge.tour.step">
        <field name="tour_id" ref="tour_receive_purchase_order"/>
        <field name="sequence">10</field>
        <field name="kind">control</field>
        <field name="name">search</field>
        <field name="label">Search</field>
        <field name="note">Find the purchase order by its number or the vendor.</field>
        <field name="res_model">purchase.order</field>
        <field name="view_type">list</field>
    </record>
    <record id="tour_receive_purchase_order_2" model="nudge.tour.step">
        <field name="tour_id" ref="tour_receive_purchase_order"/>
        <field name="sequence">20</field>
        <field name="kind">button</field>
        <field name="name">action_view_picking</field>
        <field name="label">Receipt</field>
        <field name="note">Open the order and press the Receipt button: it is the delivery note of the vendor.</field>
        <field name="res_model">purchase.order</field>
        <field name="view_type">form</field>
    </record>
    <record id="tour_receive_purchase_order_3" model="nudge.tour.step">
        <field name="tour_id" ref="tour_receive_purchase_order"/>
        <field name="sequence">30</field>
        <field name="kind">button</field>
        <field name="name">button_validate</field>
        <field name="label">Validate</field>
        <field name="note">Check the quantities received and press Validate: the stock goes up.</field>
        <field name="res_model">stock.picking</field>
        <field name="view_type">form</field>
    </record>
    <record id="tour_validate_delivery" model="nudge.tour">
        <field name="name">Validate a delivery</field>
        <field name="phrases_en">validate a delivery
deliver an order
validate a transfer
ship an order</field>
        <field name="phrases_ar">اعتماد تسليم
تسليم طلب
تحقق من التسليم</field>
        <field name="action_xmlid">stock.action_picking_tree_all</field>
        <field name="module_name">stock</field>
        <field name="is_library" eval="True"/>
    </record>
    <record id="tour_validate_delivery_1" model="nudge.tour.step">
        <field name="tour_id" ref="tour_validate_delivery"/>
        <field name="sequence">10</field>
        <field name="kind">control</field>
        <field name="name">search</field>
        <field name="label">Search</field>
        <field name="note">Find the delivery by its number, the customer or the product.</field>
        <field name="res_model">stock.picking</field>
        <field name="view_type">list</field>
    </record>
    <record id="tour_validate_delivery_2" model="nudge.tour.step">
        <field name="tour_id" ref="tour_validate_delivery"/>
        <field name="sequence">20</field>
        <field name="kind">button</field>
        <field name="name">button_validate</field>
        <field name="label">Validate</field>
        <field name="note">Open the delivery, check the quantities and press Validate: the stock goes down.</field>
        <field name="res_model">stock.picking</field>
        <field name="view_type">form</field>
    </record>
