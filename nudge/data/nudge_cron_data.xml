<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_profile_refresh" model="ir.cron">
        <field name="name">Nudge: read the database profile again</field>
        <field name="model_id" ref="model_nudge_profile"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

    <!-- Started on demand, when someone asks for something in the background.
         The interval takes up what a stopped server left behind. -->
    <record id="cron_agent_runs" model="ir.cron">
        <field name="name">Nudge: work on what was asked in the background</field>
        <field name="model_id" ref="model_nudge_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_work()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
