<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="nudge.Message">
        <div class="o_nudge_message"
             t-att-class="{
                o_nudge_message_assistant: isAssistant,
                o_nudge_message_user: !isAssistant,
                o_nudge_message_error: props.state === 'error',
             }"
             t-att-data-state="props.state">
            <!-- The direction follows the language of the text, not of the interface -->
            <div class="o_nudge_bubble" dir="auto">
                <div t-if="isWaiting and !(props.guidance and props.guidance.length)" class="o_nudge_typing" role="status">
                    <span class="visually-hidden">Nudge is thinking</span>
                    <i/><i/><i/>
                </div>
                <div t-elif="isAssistant and props.content" class="o_nudge_markdown" t-out="html"/>
                <div t-elif="props.content" class="o_nudge_plain" t-esc="props.content"/>
                <div t-if="props.attachment" class="o_nudge_seen o_nudge_attached" t-att-title="props.attachment">
                    <i class="fa fa-paperclip"/> <span t-esc="props.attachment"/>
                </div>
                <div t-if="props.spoken" class="o_nudge_seen o_nudge_said">
                    <i class="fa fa-microphone"/> <span>Said</span>
                </div>
                <div t-if="!isAssistant and props.state === 'next'" class="o_nudge_seen o_nudge_next">
                    <i class="fa fa-clock-o" aria-hidden="true"/> <span>Sent when this answer ends</span>
                </div>
                <!-- An answer: who gave it, when the model standing in did (NP-10) -->
                <div t-if="props.screen and isAssistant" class="o_nudge_seen o_nudge_fallback" t-att-title="props.screen">
                    <i class="fa fa-server" aria-hidden="true"/> <span t-esc="props.screen"/>
                </div>
                <div t-elif="props.screen" class="o_nudge_seen" t-att-title="props.screen">
                    <i class="fa fa-eye"/> <span t-esc="props.screen"/>
                </div>
                <div t-if="props.guidance and props.guidance.length" class="o_nudge_steps">
                    <!-- Theirs to choose first: the steps in writing here, or shown on the screen -->
                    <t t-if="props.choice === 'pending'">
                        <p class="o_nudge_choice_ask">I can explain it in writing here, or show you on the screen.</p>
                        <div class="o_nudge_choice">
                            <button type="button" class="btn btn-sm btn-light o_nudge_choice_text"
                                    t-on-click="() => props.onChoose('text')">
                                <i class="fa fa-align-left"/> In writing
                            </button>
                            <button type="button" class="btn btn-sm btn-primary o_nudge_choice_screen"
                                    t-on-click="() => props.onChoose('screen')">
                                <i class="fa fa-hand-o-right"/> On the screen
                            </button>
                        </div>
                    </t>
                    <t t-else="">
                        <ol>
                            <li t-foreach="props.guidance" t-as="step" t-key="step_index" t-esc="step.text"/>
                        </ol>
                        <button type="button" class="btn btn-sm btn-link o_nudge_show_again"
                                t-on-click="() => props.onShowGuidance(props.guidance)">
                            <i class="fa fa-hand-o-right"/> Show me on the screen
                        </button>
                    </t>
                </div>
                <div t-if="props.products and props.products.length" class="o_nudge_products">
                    <div t-foreach="props.products" t-as="product" t-key="product.id" class="o_nudge_product">
                        <img class="o_nudge_product_image" t-att-src="product.image" alt="" loading="lazy"/>
                        <div class="o_nudge_product_body">
                            <div class="o_nudge_product_name" t-esc="product.name"/>
                            <div class="o_nudge_product_facts">
                                <span t-if="product.price"><i class="fa fa-tag"/> <t t-esc="product.price"/></span>
                                <span t-if="product.cost" class="o_nudge_product_cost">Cost <t t-esc="product.cost"/></span>
                                <span t-if="'on_hand' in product" class="o_nudge_product_stock"
                                      t-att-class="{ o_nudge_product_none: !product.on_hand }">
                                    <i class="fa fa-cubes"/> <t t-esc="product.on_hand"/> <t t-esc="product.unit"/>
                                </span>
                            </div>
                            <div t-if="product.by_warehouse and product.by_warehouse.length" class="o_nudge_product_warehouses">
                                <span t-foreach="product.by_warehouse" t-as="place" t-key="place_index">
                                    <t t-esc="place.name"/>: <t t-esc="place.quantity"/>
                                </span>
                            </div>
                            <div t-if="product.reasons and product.reasons.length" class="o_nudge_product_why"
                                 t-esc="product.reasons.join(' · ')"/>
                        </div>
                        <button t-if="props.onOpenProduct" type="button" class="btn btn-sm btn-light o_nudge_product_open"
                                t-on-click="() => props.onOpenProduct(product.id)">Open</button>
                    </div>
                </div>
                <NudgeChart t-if="props.chart" chart="props.chart"/>
                <t t-if="props.changes" t-call="nudge.Changes"/>
                <t t-if="props.found" t-call="nudge.Found">
                    <t t-set="found" t-value="props.found"/>
                </t>
                <NudgePlanCard t-if="props.card and props.card.kind === 'plan'" card="props.card"
                               cardState="props.cardState" onDecide="props.onDecide" onUndo="props.onUndo"/>
                <t t-elif="props.card" t-call="nudge.Card"/>
                <!-- NP-04: every place is taken: the question waits for its turn, without holding the server -->
                <div t-if="props.state === 'in_line'" class="o_nudge_background o_nudge_line" role="status" aria-live="polite">
                    <div class="o_nudge_background_head">
                        <i class="fa fa-hourglass-half" aria-hidden="true"/>
                        <span>Nudge is answering other people. Your question waits for its turn.</span>
                    </div>
                    <div t-if="props.progress" class="o_nudge_background_progress o_nudge_line_place" dir="auto" t-esc="props.progress"/>
                    <button type="button" class="btn btn-sm btn-link o_nudge_line_cancel" t-on-click="cancelLine">
                        <i class="fa fa-times" aria-hidden="true"/> Cancel
                    </button>
                </div>
                <div t-if="props.state === 'line_expired'" class="o_nudge_line">
                    <button type="button" class="btn btn-sm btn-link o_nudge_line_retry" t-on-click="retryLine">
                        <i class="fa fa-repeat" aria-hidden="true"/> Try again
                    </button>
                </div>
                <div t-if="isInBackground" class="o_nudge_background" role="status">
                    <div class="o_nudge_background_head">
                        <i class="fa fa-circle-o-notch fa-spin"/>
                        <span>I'm on it in the background. I'll tell you when it is done, or when I need your answer.</span>
                    </div>
                    <div t-if="props.progress" class="o_nudge_background_progress" dir="auto" t-esc="props.progress"/>
                    <button t-if="props.onStop and props.runId" type="button"
                            class="btn btn-sm btn-link o_nudge_background_stop"
                            t-on-click="() => props.onStop(props.runId)">
                        <i class="fa fa-stop"/> Stop
                    </button>
                </div>
                <div t-if="props.remembered" class="o_nudge_remembered" dir="auto">
                    <i class="fa fa-bookmark-o"/>
                    <span>A remembered answer: no AI was asked.</span>
                    <button t-if="props.onAskAi" type="button" class="btn btn-sm btn-link o_nudge_remembered_ask"
                            t-on-click="props.onAskAi">Ask the AI instead</button>
                </div>
                <div t-if="canRate and !props.remembered" class="o_nudge_rate" dir="auto">
                    <t t-if="!props.feedback">
                        <span class="o_nudge_rate_ask">Was this helpful?</span>
                        <button type="button" class="o_nudge_rate_up" title="Yes" aria-label="Yes"
                                t-on-click="() => this.rate('up')"><i class="fa fa-thumbs-o-up"/></button>
                        <button type="button" class="o_nudge_rate_down" title="No" aria-label="No"
                                t-on-click="() => this.rate('down')"><i class="fa fa-thumbs-o-down"/></button>
                    </t>
                    <t t-elif="props.feedback === 'down' and feedback.asking">
                        <input type="text" class="o_nudge_rate_note" maxlength="400" t-ref="note"
                               placeholder="What was wrong? It becomes a lesson for a manager to approve"
                               t-model="feedback.note" t-on-keydown="onNoteKeydown"/>
                        <button type="button" class="o_nudge_rate_send" t-on-click="sendNote">Send</button>
                    </t>
                    <span t-else="" class="o_nudge_rate_done">Thanks, noted.</span>
                </div>
                <div t-if="props.error" class="o_nudge_notice" t-esc="props.error"/>
                <div t-elif="props.state === 'truncated'" class="o_nudge_notice">
                    The answer was cut short. Ask Nudge to continue.
                </div>
                <div t-elif="props.state === 'aborted'" class="o_nudge_notice">Stopped.</div>
            </div>
        </div>
    </t>

    <!-- Who changed a record: newest first, each change with its button -->
    <t t-name="nudge.Changes">
        <div class="o_nudge_changes">
            <p t-if="props.changes.note" class="o_nudge_changes_note" t-esc="props.changes.note"/>
            <ul t-if="props.changes.items.length" class="o_nudge_changes_list list-unstyled mb-1">
                <li t-foreach="props.changes.items" t-as="item" t-key="item.change_id" class="o_nudge_change mb-2">
                    <div class="o_nudge_change_head">
                        <span class="o_nudge_change_date" t-esc="item.date"/>
                        · <strong class="o_nudge_change_who" t-esc="item.who"/>
                    </div>
                    <div class="o_nudge_change_what" dir="auto">
                        <span t-esc="item.label"/>:
                        <span class="o_nudge_change_old" t-esc="item.old"/> →
                        <span class="o_nudge_change_new" t-esc="item.new"/>
                    </div>
                    <div class="o_nudge_change_actions">
                        <button t-if="item.restorable and props.changes.can_write and props.onRestore" type="button"
                                class="btn btn-sm btn-light o_nudge_change_restore"
                                t-on-click="() => props.onRestore({ kind: 'change', id: item.change_id })">
                            <i class="fa fa-undo"/> Restore the old value
                        </button>
                        <button t-if="item.restorable and props.changes.can_write and props.onRestore" type="button"
                                class="btn btn-sm btn-link o_nudge_change_restore_all"
                                t-on-click="() => props.onRestore({ kind: 'message', id: item.message_id })">
                            Restore this record as it was at <t t-esc="item.date"/>
                        </button>
                        <span t-if="!item.restorable" class="o_nudge_change_why text-muted" t-esc="item.reason"/>
                    </div>
                </li>
            </ul>
        </div>
    </t>

    <!-- What a command of the message box found, without any AI -->
    <t t-name="nudge.Found">
        <div class="o_nudge_found">
            <div t-if="found.commands and found.commands.length" class="o_nudge_found_list">
                <button t-foreach="found.commands" t-as="command" t-key="command.name" type="button"
                        class="o_nudge_suggestion o_nudge_found_command"
                        t-att-title="command.at_once ? 'Answer now' : 'Put it in the message box'"
                        t-on-click="() => props.onFound and props.onFound('command', command)">
                    <strong t-esc="command.words.join(' · ')"/>
                    <span t-if="command.kind === 'focused'" class="badge text-bg-info o_nudge_found_ai">AI</span>
                    <span class="o_nudge_quick_text" t-esc="command.hint"/>
                    <code class="o_nudge_found_example" t-esc="command.example"/>
                </button>
            </div>
            <div t-if="found.explain" class="o_nudge_found_explain">
                <p class="o_nudge_quick_head" t-esc="found.explain.title"/>
                <t t-foreach="found.explain.sections" t-as="section" t-key="section_index">
                    <p t-if="section.head" class="o_nudge_quick_text o_nudge_found_head" t-esc="section.head"/>
                    <ul class="o_nudge_found_items">
                        <li t-foreach="section.items" t-as="item" t-key="item_index"
                            t-attf-class="o_nudge_found_item o_nudge_found_{{ item.kind }}">
                            <span t-esc="item.text"/>
                            <t t-if="item.field and props.onFound">
                                <button type="button" class="btn btn-sm btn-light o_nudge_found_show"
                                        t-on-click="() => props.onFound('show', item)">Show me</button>
                                <button t-if="item.kind !== 'info'" type="button"
                                        class="btn btn-sm btn-light o_nudge_found_what"
                                        t-on-click="() => props.onFound('explain', item)">What is it?</button>
                            </t>
                        </li>
                    </ul>
                </t>
            </div>
            <div t-if="found.lists and found.lists.length" class="o_nudge_found_list">
                <button t-foreach="found.lists" t-as="list" t-key="list_index" type="button"
                        class="btn btn-sm btn-light o_nudge_found_open o_nudge_found_showlist"
                        t-att-title="list.action.name or ''"
                        t-on-click="() => props.onFound and props.onFound('list', list)">
                    <i class="fa fa-list"/> Show list
                </button>
            </div>
            <div t-if="found.menus and found.menus.length" class="o_nudge_found_list">
                <div t-foreach="found.menus" t-as="menu" t-key="menu.id" class="o_nudge_found_row">
                    <button type="button" class="o_nudge_suggestion o_nudge_found_menu" title="Show me the way"
                            t-on-click="() => props.onFound and props.onFound('menu', menu)">
                        <i class="fa fa-location-arrow"/> <t t-esc="menu.path"/>
                    </button>
                    <button type="button" class="btn btn-sm btn-light o_nudge_found_open" title="Open it"
                            t-on-click="() => props.onFound and props.onFound('open_menu', menu)">Open</button>
                </div>
            </div>
            <div t-if="found.tours and found.tours.length" class="o_nudge_found_list">
                <button t-foreach="found.tours" t-as="tour" t-key="tour.id" type="button"
                        class="o_nudge_suggestion o_nudge_found_tour" title="Show me, step by step"
                        t-on-click="() => props.onFound and props.onFound('tour', tour)">
                    <i class="fa fa-map-signs"/> <strong t-esc="tour.name"/>
                    <span class="o_nudge_quick_app" t-esc="' · ' + tour.steps"/>
                </button>
            </div>
            <div t-if="found.health" class="o_nudge_found_list o_nudge_found_health">
                <div t-foreach="found.health.findings" t-as="finding" t-key="finding.id"
                     t-attf-class="o_nudge_found_row o_nudge_found_finding o_nudge_finding_{{ finding.severity }}">
                    <div class="o_nudge_found_body">
                        <strong t-esc="finding.count"/>
                        <span class="o_nudge_quick_text" t-esc="finding.message"/>
                        <span t-if="finding.is_new" class="badge text-bg-danger">New</span>
                    </div>
                    <button t-if="finding.can_show" type="button" class="btn btn-sm btn-light o_nudge_found_open"
                            t-on-click="() => props.onFound and props.onFound('finding', finding)">Show me</button>
                </div>
                <button type="button" class="btn btn-sm btn-light o_nudge_found_report"
                        t-on-click="() => props.onFound and props.onFound('health_report', found.health)">
                    <i class="fa fa-heartbeat"/> Open the report
                </button>
            </div>
            <div t-if="found.can_record" class="o_nudge_found_list">
                <button type="button" class="btn btn-sm btn-light o_nudge_found_record_tour"
                        t-on-click="() => props.onFound and props.onFound('record_tour', {})">
                    <i class="fa fa-circle text-danger"/> Record a tour
                </button>
            </div>
            <div t-if="found.settings and found.settings.length" class="o_nudge_found_list">
                <button t-foreach="found.settings" t-as="setting" t-key="setting.app + setting.field" type="button"
                        class="o_nudge_suggestion o_nudge_found_setting" title="Show me the way"
                        t-on-click="() => props.onFound and props.onFound('setting', setting)">
                    <i class="fa fa-cog"/> <strong t-esc="setting.label"/>
                    <span class="o_nudge_quick_app" t-esc="' · ' + setting.app_label"/>
                    <span t-if="setting.help" class="o_nudge_quick_text" t-esc="setting.help"/>
                </button>
            </div>
            <div t-if="found.pages and found.pages.length" class="o_nudge_found_list">
                <a t-foreach="found.pages" t-as="page" t-key="page.url" t-att-href="safeUrl(page.url)" target="_blank"
                   rel="noopener noreferrer" class="o_nudge_suggestion o_nudge_found_page">
                    <i class="fa fa-book"/> <strong t-esc="page.title"/>
                    <span class="o_nudge_quick_text" t-esc="page.snippet"/>
                </a>
            </div>
            <div t-if="found.records and found.records.length" class="o_nudge_found_list">
                <div t-foreach="found.records" t-as="record" t-key="record.model + record.id"
                     class="o_nudge_found_row o_nudge_found_record">
                    <div class="o_nudge_found_body">
                        <strong t-esc="record.name"/>
                        <span class="o_nudge_quick_text">
                            <t t-esc="record.kind"/><t t-if="record.state" t-esc="' · ' + record.state"/>
                        </span>
                    </div>
                    <button type="button" class="btn btn-sm btn-light o_nudge_found_open"
                            t-on-click="() => props.onFound and props.onFound('record', record)">Open</button>
                </div>
            </div>
            <div t-if="found.passages and found.passages.length" class="o_nudge_found_list">
                <blockquote t-foreach="found.passages" t-as="passage" t-key="passage.id" class="o_nudge_found_passage"
                            dir="auto">
                    <p t-esc="passage.text"/>
                    <a t-att-href="safeUrl(passage.url)" target="_blank" rel="noopener noreferrer" class="o_nudge_found_source">
                        <i class="fa fa-file-text-o"/> <t t-esc="passage.file"/>
                        <t t-if="passage.page">, <span>page</span> <t t-esc="passage.page"/></t>
                    </a>
                </blockquote>
            </div>
            <pre t-if="found.code" class="o_nudge_card_code o_nudge_found_code" dir="ltr" t-esc="found.code"/>
            <div t-if="found.table and found.table.rows.length" class="o_nudge_found_table" dir="ltr">
                <table class="table table-sm">
                    <thead>
                        <tr><th t-foreach="found.table.columns" t-as="column" t-key="column_index" t-esc="column"/></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="found.table.rows" t-as="row" t-key="row_index">
                            <td t-foreach="row" t-as="value" t-key="value_index" t-esc="cell(value)"/>
                        </tr>
                    </tbody>
                </table>
                <p t-if="found.table.note" class="o_nudge_quick_text" t-esc="found.table.note"/>
            </div>
        </div>
    </t>

    <!-- What Nudge is about to do. Nothing is done before the person says yes. -->
    <t t-name="nudge.Card">
        <div class="o_nudge_card" t-att-data-state="props.cardState"
             t-att-class="{ o_nudge_card_sensitive: props.card.sensitive }">
            <div class="o_nudge_card_title">
                <i t-if="props.card.sensitive" class="fa fa-exclamation-triangle"
                   title="Check it twice: this is not taken back with a click"/>
                <span t-esc="props.card.title"/>
            </div>
            <ul t-if="props.card.records.length" class="o_nudge_card_records">
                <li t-foreach="props.card.records" t-as="record" t-key="record.id" t-esc="record.name"/>
            </ul>
            <t t-call="nudge.CardLines">
                <t t-set="lines" t-value="props.card.lines"/>
            </t>
            <div t-if="props.card.plan" class="o_nudge_plan">
                <p class="o_nudge_plan_count" t-esc="planCount"/>
                <ul t-if="props.card.plan.failing.length" class="o_nudge_plan_failing">
                    <li t-foreach="props.card.plan.failing" t-as="entry" t-key="entry_index" dir="auto">
                        <strong t-esc="entry.name"/>: <t t-esc="entry.reason"/>
                    </li>
                    <li t-if="props.card.plan.more_failing" class="o_nudge_plan_more">
                        + <t t-esc="props.card.plan.more_failing"/>
                    </li>
                </ul>
                <p t-if="!props.card.plan.undoable" class="o_nudge_plan_note">
                    <i class="fa fa-exclamation-triangle"/> What a button does is not taken back by Undo.
                </p>
                <p t-if="props.card.plan.background" class="o_nudge_plan_note">
                    <i class="fa fa-clock-o"/> Many records: done in the background, while you go on.
                </p>
            </div>
            <div t-if="props.cardState === 'pending'" class="o_nudge_card_actions">
                <button type="button" class="btn btn-sm btn-primary o_nudge_confirm"
                        t-on-click="() => this.decide('confirm')">
                    <t t-if="props.card.plan">Yes, all of them</t>
                    <t t-else="">Yes, do it</t>
                </button>
                <button t-if="props.card.plan and props.card.plan.passing and props.card.plan.passing &lt; props.card.plan.total"
                        type="button" class="btn btn-sm btn-secondary o_nudge_confirm_passing"
                        t-on-click="() => this.decide('passing')">
                    <t t-esc="passingLabel"/>
                </button>
                <button type="button" class="btn btn-sm btn-light o_nudge_decline"
                        t-on-click="() => this.decide('decline')">
                    No
                </button>
            </div>
            <div t-else="" class="o_nudge_card_outcome" role="status">
                <i t-if="props.cardState === 'deciding' or props.cardState === 'working'" class="fa fa-circle-o-notch fa-spin"/>
                <i t-elif="props.card.undone" class="fa fa-undo"/>
                <i t-elif="props.cardState === 'done'" class="fa fa-check"/>
                <i t-elif="props.cardState === 'failed'" class="fa fa-times"/>
                <span t-esc="outcome"/>
            </div>
            <div t-if="props.cardError and props.cardState === 'failed'" class="o_nudge_card_error"
                 t-esc="props.cardError"/>
            <t t-if="props.card.verify and props.cardState === 'done'" t-call="nudge.Verify">
                <t t-set="verify" t-value="props.card.verify"/>
            </t>
            <button t-if="props.cardCanUndo and props.onUndo" type="button"
                    class="btn btn-sm btn-link o_nudge_undo" title="Write back what was there before"
                    t-on-click="() => props.onUndo(props.card.step_id)">
                <i class="fa fa-undo"/> Undo
            </button>
        </div>
    </t>

    <t t-name="nudge.CardLines">
        <dl t-if="lines.length" class="o_nudge_card_lines">
            <t t-foreach="lines" t-as="line" t-key="line_index">
                <dt t-esc="line.label"/>
                <dd t-if="line.lines" class="o_nudge_card_nested">
                    <t t-call="nudge.CardLines">
                        <t t-set="lines" t-value="line.lines"/>
                    </t>
                </dd>
                <dd t-else="" dir="auto" t-att-class="{ o_nudge_card_wide: line.html }">
                    <t t-if="'before' in line">
                        <del class="o_nudge_card_before" t-esc="show(line.before)"/>
                        <i class="fa fa-long-arrow-right o_nudge_card_arrow"/>
                    </t>
                    <!-- An email as its reader will see it, in a frame of its
                         own: sandboxed without scripts, so nothing in it runs;
                         the same origin only lets the page measure it -->
                    <iframe t-if="line.html" class="o_nudge_card_email" sandbox="allow-same-origin"
                            t-att-srcdoc="line.html" t-att-title="line.label"/>
                    <pre t-elif="line.code" class="o_nudge_card_code" t-esc="show(line.value)"/>
                    <span t-else="" class="o_nudge_card_value" t-esc="show(line.value)"/>
                </dd>
            </t>
        </dl>
    </t>

</templates>
