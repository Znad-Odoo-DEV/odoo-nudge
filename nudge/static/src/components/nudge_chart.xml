<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="nudge.Chart">
        <div class="o_nudge_chart" t-ref="root">
            <div class="o_nudge_chart_title" dir="auto" t-esc="props.chart.title"/>
            <div class="o_nudge_chart_canvas">
                <canvas t-ref="canvas" role="img" t-att-aria-label="props.chart.title"/>
            </div>
            <div t-if="props.chart.note" class="o_nudge_chart_note text-muted" dir="auto" t-esc="props.chart.note"/>
            <div class="o_nudge_chart_actions">
                <button t-if="props.chart.action" type="button" class="btn btn-sm btn-light o_nudge_chart_open"
                        t-on-click="openReport">
                    <i class="fa fa-external-link me-1"/>Open as report
                </button>
                <button type="button" class="btn btn-sm btn-light o_nudge_chart_download" t-on-click="downloadPng">
                    <i class="fa fa-download me-1"/>Download PNG
                </button>
            </div>
        </div>
    </t>

</templates>
