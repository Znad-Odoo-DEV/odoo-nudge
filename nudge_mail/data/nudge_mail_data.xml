<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_nudge_mail_classify" model="ir.cron">
        <field name="name">Nudge: sort the mail that waited for the AI</field>
        <field name="model_id" ref="model_nudge_mail_proposal"/>
        <field name="state">code</field>
        <field name="code">model._cron_classify()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <!-- Off until a company turns the Mail Agent on: the company switch starts it -->
        <field name="active" eval="False"/>
    </record>
</odoo>
