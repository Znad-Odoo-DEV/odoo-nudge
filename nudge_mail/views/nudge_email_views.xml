<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The window a button opens: the email for the record, to read and change -->
    <record id="nudge_email_review_view_form" model="ir.ui.view">
        <field name="name">nudge.email.review.view.form</field>
        <field name="model">nudge.email.review</field>
        <field name="arch" type="xml">
            <form string="Email">
                <field name="flow_id" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="without_email" invisible="1"/>
                <div class="alert alert-warning mb-3" role="alert" invisible="not missing">
                    <strong>Fill in on the record first:</strong>
                    <field name="missing" class="ms-1" readonly="1"/>
                </div>
                <group>
                    <field name="record_name"/>
                    <field name="email_from"/>
                    <field name="email_to" placeholder="Addresses separated by commas"/>
                    <field name="email_cc" placeholder="Addresses separated by commas"/>
                    <field name="subject"/>
                </group>
                <field name="body" widget="html" nolabel="1" options="{'codeview': true}"/>
                <group>
                    <field name="attachment_ids" widget="many2many_binary" string="Attach a File" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary" data-hotkey="q"/>
                    <button name="action_without_email" type="object" string="Without the Email"
                            class="btn-secondary" invisible="not without_email"
                            confirm="Go on without sending the email?"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="nudge_email_flow_view_list" model="ir.ui.view">
        <field name="name">nudge.email.flow.view.list</field>
        <field name="model">nudge.email.flow</field>
        <field name="arch" type="xml">
            <tree string="Emails with Review">
                <field name="name"/>
                <field name="model_id"/>
                <field name="method_label"/>
                <field name="template_id"/>
                <field name="without_email" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="nudge_email_flow_view_form" model="ir.ui.view">
        <field name="name">nudge.email.flow.view.form</field>
        <field name="model">nudge.email.flow</field>
        <field name="arch" type="xml">
            <form string="Email with Review">
                <sheet>
                    <widget name="web_ribbon" title="Off" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="template_id" options="{'no_create': True}"/>
                            <field name="method_label"/>
                            <field name="method"/>
                        </group>
                        <group>
                            <field name="required_field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="without_email"/>
                            <field name="button_groups"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Made With It">
                        <field name="view_id"/>
                        <field name="action_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_email_flow_action" model="ir.actions.act_window">
        <field name="name">Emails with Review</field>
        <field name="res_model">nudge.email.flow</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No email with review yet</p>
            <p>In Developer mode, ask Nudge for a button that opens an email to read before it goes.</p>
        </field>
    </record>

    <menuitem id="nudge_email_flow_menu" name="Emails with Review" sequence="40"
              parent="nudge.nudge_menu_configuration" action="nudge_email_flow_action"
              groups="base.group_system"/>
</odoo>
