<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="nudge_spreadsheet_rule_own" model="ir.rule">
        <field name="name">Nudge spreadsheets: one's own</field>
        <field name="model_id" ref="model_nudge_spreadsheet"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('nudge.group_nudge_user'))]"/>
    </record>
    <record id="nudge_spreadsheet_rule_system" model="ir.rule">
        <field name="name">Nudge spreadsheets: administrators see all</field>
        <field name="model_id" ref="model_nudge_spreadsheet"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
