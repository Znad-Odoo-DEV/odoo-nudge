<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nudge_spreadsheet_view_list" model="ir.ui.view">
        <field name="name">nudge.spreadsheet.view.list</field>
        <field name="model">nudge.spreadsheet</field>
        <field name="arch" type="xml">
            <list default_order="id desc">
                <field name="name"/>
                <field name="user_id"/>
                <field name="create_date" string="Made On"/>
                <button name="action_open" type="object" string="Open" icon="fa-table" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="nudge_spreadsheet_view_form" model="ir.ui.view">
        <field name="name">nudge.spreadsheet.view.form</field>
        <field name="model">nudge.spreadsheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open the Spreadsheet" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="conversation_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nudge_spreadsheet_action" model="ir.actions.act_window">
        <field name="name">Spreadsheets</field>
        <field name="res_model">nudge.spreadsheet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No spreadsheet yet</p>
            <p>Ask Nudge for a comparison or a report and choose a spreadsheet: it lands here.</p>
        </field>
    </record>

    <menuitem id="nudge_menu_spreadsheets" name="Spreadsheets" parent="nudge.nudge_menu_reports"
              action="nudge_spreadsheet_action" sequence="30" groups="nudge.group_nudge_manager"/>
</odoo>
